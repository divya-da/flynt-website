{
  "hosting": [
    {
      "target": "flynt-website",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/go",
          "function": {
            "functionId": "shortLinkRedirect",
            "region": "us-central1"
          }
        },
        {
          "source": "/go/**",
          "function": {
            "functionId": "shortLinkRedirect",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/404.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "target": "flynt-marketing",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/go",
          "function": {
            "functionId": "shortLinkRedirect",
            "region": "us-central1"
          }
        },
        {
          "source": "/go/**",
          "function": {
            "functionId": "shortLinkRedirect",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/404.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ]
}
