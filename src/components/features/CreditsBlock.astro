---
// Credits note with a link to pricing. Each page supplies its own wording.
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---

<section class="section fx-credits-section">
  <div class="container">
    <div class="fx-credits">
      <div class="fx-credits__left">
        <div class="tag" style="margin-bottom: 16px;">Credits</div>
        <h3 set:html={title} />
        <p>{body}</p>
      </div>
      <a href="/pricing" class="btn btn--outline">See pricing →</a>
    </div>
  </div>
</section>

<style>
.fx-credits-section { background: var(--slate-50); }
.fx-credits {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 32px;
  padding: 32px 36px;
  border: 1px solid var(--slate-200);
  border-radius: 14px;
  background: #fff;
}
.fx-credits__left { flex: 999 1 380px; min-width: 0; }
.fx-credits__left h3 {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--slate-900);
  margin: 0 0 12px;
  letter-spacing: -0.02em;
  -webkit-text-stroke: 0.4px var(--slate-900);
}
.fx-credits__left p { font-size: 0.95rem; line-height: 1.65; color: var(--slate-600); margin: 0; }

@media (max-width: 768px) {
  .fx-credits { padding: 24px; }
}
</style>
