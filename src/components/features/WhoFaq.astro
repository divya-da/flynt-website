---
// "Who it is for" cards followed by a two-column FAQ.
interface Item {
  title: string;
  body: string;
}
interface Props {
  heading: string;   // plain text before the accent
  accent: string;    // purple part of the heading
  personas: Item[];
  faqs: Item[];
}
const { heading, accent, personas, faqs } = Astro.props;
---

<section class="section fx-who">
  <div class="container">
    <div class="fx-who__head">
      <div class="tag">Who it is for</div>
      <h2 class="fx-who__h2">{heading} <span class="fx-hl">{accent}</span></h2>
    </div>

    <div class="fx-who__grid">
      {personas.map((p) => (
        <div class="fx-who__card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section fx-faq-section">
  <div class="container">
    <div class="fx-faq">
      <h3 class="fx-faq__title">Questions</h3>
      <div class="fx-faq__grid">
        {faqs.map((f) => (
          <div class="fx-faq__item">
            <h4>{f.title}</h4>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.fx-who { background: var(--slate-50); }
.fx-faq-section { background: var(--white); }
.fx-who__head { max-width: 860px; margin-bottom: 40px; display: flex; flex-direction: column; }
.fx-who__h2 { font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0; }
.fx-hl { color: var(--purple); -webkit-text-stroke: 0; }
.fx-who__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 64px; }
.fx-who__card { background: var(--white); border: 1px solid var(--slate-200); border-radius: 16px; padding: 28px; }
.fx-who__card h3 { font-size: 1.2rem; font-weight: 800; margin: 0 0 8px; }
.fx-who__card p { margin: 0; font-size: 1rem; }
.fx-faq__title { font-size: 1.6rem; font-weight: 800; margin-bottom: 24px; }
.fx-faq__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.fx-faq__item { padding: 4px 0; }
.fx-faq__item h4 { font-size: 1.05rem; margin: 0 0 8px; -webkit-text-stroke: 0; }
.fx-faq__item p { margin: 0; font-size: 0.98rem; }

@media (max-width: 768px) {
  .fx-who__grid, .fx-faq__grid { grid-template-columns: 1fr; }
}
</style>
