<script>
  const PLANS = {
    lite:    { '2500': [87,  77],  '4000': [137, 117] },
    starter: { '4000': [147, 127], '6000': [207, 177], '8000': [267, 237] },
    pro:     { '8000': [297, 247], '12000': [417, 367], '16000': [537, 477] }
  };

  let billingMode = 'annual';

  function getSelectedCredits(plan) {
    const checked = document.querySelector(`[data-plan="${plan}"] input[type="radio"]:checked`);
    return checked ? checked.value : Object.keys(PLANS[plan])[0];
  }

  function updateCard(plan) {
    const credits = getSelectedCredits(plan);
    const pair = PLANS[plan][credits];
    const price = billingMode === 'annual' ? pair[1] : pair[0];
    const annualTotal = pair[1] * 12;
    const saving = (pair[0] - pair[1]) * 12;

    const card = document.querySelector(`[data-plan="${plan}"]`);
    if (!card) return;

    card.querySelector('.plan__amount').textContent = price;

    const billedEl = card.querySelector('.plan__billed-inline');
    if (billedEl) billedEl.textContent = `Billed $${annualTotal.toLocaleString()}/yr`;

    const teaserEl = card.querySelector('.plan__annual-teaser');
    if (teaserEl) teaserEl.textContent = `Switch to annual — save $${saving}/yr`;

    const tips = card.querySelectorAll('.plan__tip--multi span');
    if (tips.length >= 2) {
      tips[0].textContent = `$${pair[1]}/mo on annual`;
      tips[1].textContent = `Save $${saving}/yr`;
    }
  }

  function updateAllCards() {
    ['lite', 'starter', 'pro'].forEach(updateCard);
  }

  function setBilling(type) {
    billingMode = type;
    const isMonthly = type === 'monthly';

    document.getElementById('toggle-monthly').classList.toggle('toggle-btn--active', isMonthly);
    document.getElementById('toggle-annual').classList.toggle('toggle-btn--active', !isMonthly);

    document.querySelectorAll('.plan__annual-info').forEach(el => {
      (el as HTMLElement).style.display = isMonthly ? 'none' : 'block';
    });

    document.querySelectorAll('.plan__annual-teaser').forEach(el => {
      (el as HTMLElement).style.display = isMonthly ? 'block' : 'none';
    });

    document.querySelectorAll('.th-price[data-monthly][data-annual]').forEach(el => {
      el.textContent = isMonthly ? (el as HTMLElement).dataset.monthly : (el as HTMLElement).dataset.annual;
    });

    document.querySelectorAll('[data-monthly][data-annual]:not(.th-price):not([data-plan] .plan__amount)').forEach(el => {
      el.textContent = isMonthly ? (el as HTMLElement).dataset.monthly : (el as HTMLElement).dataset.annual;
    });

    updateAllCards();
  }

  function toggleTip(el) {
    const isOpen = el.classList.contains('tip--open');
    document.querySelectorAll('.plan__info-btn.tip--open').forEach(b => b.classList.remove('tip--open'));
    if (!isOpen) el.classList.add('tip--open');
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.plan__info-btn')) {
      document.querySelectorAll('.plan__info-btn.tip--open').forEach(b => b.classList.remove('tip--open'));
    }
  });

  document.querySelectorAll('.plan__credit-opts input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const card = (radio as HTMLElement).closest('[data-plan]') as HTMLElement;
      if (card) updateCard(card.dataset.plan);
    });
  });

  (window as any).setBilling = setBilling;
  (window as any).toggleTip = toggleTip;

  setBilling('annual');
</script>

