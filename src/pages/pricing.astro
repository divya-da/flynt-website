              <th>Lite<br /><span class="th-price" data-monthly="$87/mo" data-annual="$77/mo">$77/mo</span></th>
              <th class="compare-table__featured">Starter<br /><span class="th-price" data-monthly="$147/mo" data-annual="$127/mo">$127/mo</span></th>
              <th>Pro<br /><span class="th-price" data-monthly="$297/mo" data-annual="$247/mo">$247/mo</span></th>
              <th>Scale<br /><span class="th-price">Contact Sales</span></th>
            </tr>
          </thead>
          <tbody>
            <!-- Signal Intelligence -->
            <tr class="compare-table__section-header">
              <td colspan="5">Signal Intelligence</td>
            </tr>
            <tr>
              <td>AI Agents Included</td>
              <td>None</td>
              <td class="compare-table__featured">1</td>
              <td>3</td>
              <td>12+</td>
            </tr>
            <tr>
              <td>Max Leads Per Day</td>
              <td>Manual</td>
              <td class="compare-table__featured">30/run · no daily limit</td>
              <td>30/run per agent</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Active Hiring Signal Detection</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Funding &amp; M&amp;A Signals</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI Match Scoring</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Decision-Maker Identification</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI Personalization Hooks</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Advanced AI Targeting</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <!-- Outreach & Campaigns -->
            <tr class="compare-table__section-header">
              <td colspan="5">Outreach &amp; Campaigns</td>
            </tr>
            <tr>
              <td>Flynt Campaigns</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>MPC Search</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>LinkedIn Outreach (Connection Requests + Messages)</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Prebuilt Sequences</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI-Written Outreach Personalization (Email + LinkedIn)</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <!-- CRM & Inbox -->
            <tr class="compare-table__section-header">
              <td colspan="5">CRM &amp; Inbox</td>
            </tr>
            <tr>
              <td>Flynt CRM</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Unified Inbox</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Performance Dashboard</td>
              <td><span class="t-check">✓</span></td>
