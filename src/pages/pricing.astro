            </tr>
            <tr>
              <td>Signal Agent</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured">Add-on $49/mo</td>
              <td>Included</td>
              <td>Included</td>
            </tr>
            <tr>
              <td>Add Extra Agents</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured">+$44/mo (sharing credits)</td>
              <td>Up to 6</td>
              <td>Unlimited</td>
            </tr>
