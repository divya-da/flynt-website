---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pricing — Flynt AI"
  description="Three plans built for where you are and where you're going. Every tier includes Flynt's core intelligence system."
>

<div class="pricing-page">

  <!-- Header -->
  <section class="page-hero">
    <div class="container">
      <div class="tag">Pricing</div>
      <h1><span class="accent">AI agents</span> for every stage.</h1>
      <p>Three plans. Every tier includes Flynt's core intelligence system.</br>Upgrade as your operation scales.</p>
    </div>
  </section>

  <!-- Cards -->
  <section class="section pricing-section">
    <div class="container">

      <!-- Billing Toggle -->
      <div class="billing-toggle">
        <button class="toggle-btn" id="toggle-monthly" onclick="setBilling('monthly')">Monthly</button>
        <button class="toggle-btn toggle-btn--active" id="toggle-annual" onclick="setBilling('annual')">
          Annual <span class="toggle-badge">Save up to $1,200/yr</span>
        </button>
      </div>

      <div class="pricing-grid">

        <!-- Starter -->
        <div class="plan">
          <div class="plan__header">
            <h3>Starter</h3>
            <p class="plan__tagline">For solo recruiters building their first automated BD pipeline.</p>
            <div class="plan__price">
              <span class="plan__dollar">$</span><span class="plan__amount plan__annual-only" data-monthly="139" data-annual="99">99</span>
              <span class="plan__period">/mo</span>
            </div>
            <div class="plan__annual-teaser">Switch to annual — save $480/yr</div>
            <div class="plan__annual-info">
              <div class="plan__billing-row">
                <span class="plan__billed-inline">Billed $1,188/yr</span>
                <span class="plan__info-btn plan__has-tip" tabindex="0" onclick="toggleTip(this)">
                  <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M9 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="5.5" r="1" fill="currentColor"/></svg>
                  <span class="plan__tip plan__tip--multi"><span>$99/mo per agent</span><span>≈ 3 months free</span><span>Save $480/yr</span></span>
                </span>
              </div>
            </div>
            <a href="https://app.tryflynt.ai/" class="btn btn--outline plan__cta">Subscribe</a>
            <a href="https://app.tryflynt.ai/" class="btn btn--outline plan__cta plan__cta--try">Try Now</a>
            <p class="plan__sub-cta">7-day trial · Cancel anytime</p>
          </div>
          <div class="plan__features-label">What's Included</div>
          <ul class="plan__features">
            <li><span class="check">✓</span> 1 AI Agent</li>
            <li><span class="check">✓</span> Up to 30 scored, researched leads daily (~900/mo)</li>
            <li><span class="check">✓</span> Match scoring + written fit breakdown per lead</li>
            <li><span class="check">✓</span> Decision-maker contacts + company signals</li>
            <li><span class="check">✓</span> 3 AI-written personalization hooks per lead</li>
            <li><span class="check">✓</span> Flynt Campaigns</li>
            <li><span class="check">✓</span> Flynt Pipeline (CRM)</li>
            <li><span class="check">✓</span> Unified Inbox</li>
            <li><span class="check">✓</span> Performance Dashboard</li>
            <li><span class="check">✓</span> Email Support</li>
          </ul>
        </div>

        <!-- Pro (highlighted) -->
        <div class="plan plan--featured">
          <div class="plan__badge">Most Popular</div>
          <div class="plan__header">
            <h3>Pro</h3>
            <p class="plan__tagline">For recruitment agencies running research and outreach in one place.</p>
            <div class="plan__price">
              <span class="plan__dollar plan__dollar--featured">$</span><span class="plan__amount plan__amount--featured plan__annual-only" data-monthly="267" data-annual="199">199</span>
              <span class="plan__period">/mo</span>
            </div>
            <div class="plan__annual-teaser">Switch to annual — save $816/yr</div>
            <div class="plan__annual-info">
              <div class="plan__billing-row">
                <span class="plan__billed-inline">Billed $2,388/yr</span>
                <span class="plan__info-btn plan__has-tip" tabindex="0" onclick="toggleTip(this)">
                  <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M9 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="5.5" r="1" fill="currentColor"/></svg>
                  <span class="plan__tip plan__tip--multi"><span>$99/mo per agent</span><span>≈ 3 months free</span><span>Save $816/yr</span></span>
                </span>
              </div>
            </div>
            <a href="https://app.tryflynt.ai/" class="btn btn--primary plan__cta">Subscribe</a>
            <a href="https://app.tryflynt.ai/" class="btn btn--outline plan__cta plan__cta--try">Try Now</a>
            <p class="plan__sub-cta">7-day trial · Cancel anytime</p>
          </div>
          <div class="plan__features-label">What's Included</div>
          <ul class="plan__features">
            <li><span class="check">✓</span> Everything in Starter</li>
            <li><span class="check">✓</span> 2 AI Agents</li>
            <li><span class="check">✓</span> Up to 60 scored, researched leads daily (~1,800/mo)</li>
            <li><span class="check">✓</span> 8 AI-written personalization hooks per lead</li>
            <li><span class="check">✓</span> Advanced targeting and filtering</li>
            <li><span class="check">✓</span> Option to purchase 1 Extra Agent</li>
            <li><span class="check">✓</span> Premium Support</li>
          </ul>
        </div>

        <!-- Growth -->
        <div class="plan">
          <div class="plan__header">
            <h3>Growth</h3>
            <p class="plan__tagline">For agencies and teams scaling across multiple markets.</p>
            <div class="plan__price">
              <span class="plan__dollar">$</span><span class="plan__amount plan__annual-only" data-monthly="499" data-annual="399">399</span>
              <span class="plan__period">/mo</span>
            </div>
            <div class="plan__annual-teaser">Switch to annual — save $1,200/yr</div>
            <div class="plan__annual-info">
              <div class="plan__billing-row">
                <span class="plan__billed-inline">Billed $4,788/yr</span>
                <span class="plan__info-btn plan__has-tip" tabindex="0" onclick="toggleTip(this)">
                  <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M9 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="5.5" r="1" fill="currentColor"/></svg>
                  <span class="plan__tip plan__tip--multi"><span>$99/mo per agent</span><span>≈ 2 months free</span><span>Save $1,200/yr</span></span>
                </span>
              </div>
            </div>
            <a href="https://app.tryflynt.ai/" class="btn btn--outline plan__cta">Subscribe</a>
            <a href="https://app.tryflynt.ai/" class="btn btn--outline plan__cta plan__cta--try">Try Now</a>
            <p class="plan__sub-cta">7-day trial · Cancel anytime</p>
          </div>
          <div class="plan__features-label">What's Included</div>
          <ul class="plan__features">
            <li><span class="check">✓</span> Everything in Pro</li>
            <li><span class="check">✓</span> 4 AI Agents</li>
            <li><span class="check">✓</span> Up to 120 scored, researched leads daily (~3,600/mo)</li>
            <li><span class="check">✓</span> Option to purchase up to 4 Extra Agents</li>
            <li><span class="check">✓</span> Premium Support</li>
          </ul>
        </div>

      </div>

      <!-- Scale / Enterprise banner -->
      <div class="enterprise-banner">
        <div class="enterprise-banner__left">
          <div class="enterprise-banner__title">
            <span class="enterprise-banner__name">Scale</span>
            <span class="enterprise-banner__tag">Enterprise</span>
          </div>
          <p class="enterprise-banner__desc">For agencies and high-volume operations. Unlimited agents, custom pricing.</p>
        </div>
        <a href="mailto:info@tryflynt.ai" class="btn btn--outline enterprise-banner__cta">Get in Touch</a>
      </div>

      <p class="pricing-disclaimer">
        Pricing reflects time saved and consistency gained — not guaranteed outcomes.</br>Flynt prepares opportunity. Results depend on your execution.
      </p>

    </div>
  </section>

  <!-- Tier Comparison Table -->
  <section class="section comparison-section">
    <div class="container">
      <div class="section-header section-header--center">
        <h2>What's <span class="accent-word">included</span> at each level.</h2>
      </div>
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="compare-table__feature"></th>
              <th>Starter<br /><span class="th-price" data-monthly="$139/mo" data-annual="$99/mo">$99/mo</span></th>
              <th class="compare-table__featured">Pro<br /><span class="th-price" data-monthly="$267/mo" data-annual="$199/mo">$199/mo</span></th>
              <th>Growth<br /><span class="th-price" data-monthly="$499/mo" data-annual="$399/mo">$399/mo</span></th>
              <th>Scale<br /><span class="th-price">Contact Sales</span></th>
            </tr>
          </thead>
          <tbody>
            <!-- Signal Intelligence -->
            <tr class="compare-table__section-header">
              <td colspan="5">Signal Intelligence</td>
            </tr>
            <tr>
              <td>AI Agents Included</td>
              <td>1</td>
              <td class="compare-table__featured">2</td>
              <td>4</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Max Leads Per Day</td>
              <td>30 <span class="compare-sub">(~900/mo)</span></td>
              <td class="compare-table__featured">60 <span class="compare-sub">(~1,800/mo)</span></td>
              <td>120 <span class="compare-sub">(~3,600/mo)</span></td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Active Hiring Signal Detection</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI Match Scoring</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Decision-Maker Identification</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI Personalization Hooks</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Advanced AI Targeting</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <!-- Outreach & Campaigns -->
            <tr class="compare-table__section-header">
              <td colspan="5">Outreach &amp; Campaigns</td>
            </tr>
            <tr>
              <td>Flynt Campaigns</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Prebuilt 6-Email Sequences</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>AI-Written Outreach Personalization</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <!-- CRM & Inbox -->
            <tr class="compare-table__section-header">
              <td colspan="5">CRM &amp; Inbox</td>
            </tr>
            <tr>
              <td>Flynt CRM / Pipeline</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Unified Inbox</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Performance Dashboard</td>
              <td><span class="t-check">✓</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <!-- Scale & Support -->
            <tr class="compare-table__section-header">
              <td colspan="5">Scale &amp; Support</td>
            </tr>
            <tr>
              <td>Add Extra Agents</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured">1 Add-on</td>
              <td>4 Add-ons</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Premium Support</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured"><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
            <tr>
              <td>Dedicated Onboarding</td>
              <td><span class="t-dash">✕</span></td>
              <td class="compare-table__featured"><span class="t-dash">✕</span></td>
              <td><span class="t-dash">✕</span></td>
              <td><span class="t-check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="section addons-section">
    <div class="container">
      <div class="section-header section-header--center">
        <div class="tag">Extend your agent</div>
        <h2>Give your agent <span class="accent-word">new capabilities.</span></h2>
        <p>Your agent already works around the clock. These add-ons tell it to do more.</p>
      </div>

      <div class="addon-card">
        <div class="addon-card__header">
          <div class="addon-card__title-row">
            <h3 class="addon-card__name">Phone Number Discovery</h3>
            <span class="addon-badge">Most Requested</span>
          </div>
          <p class="addon-card__value">Your agent finds the lead — then keeps going to surface a verified phone number for each one. No separate tool, no manual lookup. That's <strong>~900 direct dials per month</strong> at just <strong class="addon-card__highlight">$0.15/lead</strong> — <strong>10–15x cheaper</strong> than standalone enrichment tools.</p>
        </div>

        <div class="addon-compare table-wrap">
          <table class="compare-table compare-table--competitors">
            <thead>
              <tr>
                <th class="compare-table__feature"></th>
                <th class="compare-table__featured">Flynt Add-on</th>
                <th>Lusha Pro</th>
                <th>Kaspr Starter</th>
                <th>Lead411 Spark</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="compare-table__feature">Phone Numbers</td>
                <td class="compare-table__featured">~900/mo</td>
                <td>~4/mo</td>
                <td>~50/mo</td>
                <td>200/mo</td>
              </tr>
              <tr>
                <td class="compare-table__feature">Cost/Lead</td>
                <td class="compare-table__featured"><strong>$0.15</strong></td>
                <td>$5.61</td>
                <td>$0.98</td>
                <td>$0.50</td>
              </tr>
              <tr>
                <td class="compare-table__feature">Equiv. cost for 900 numbers</td>
                <td class="compare-table__featured"><strong>$139</strong></td>
                <td><strong>$5,049</strong></td>
                <td><strong>$882</strong></td>
                <td><strong>$450</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="addon-plan-pricing">
          <div class="addon-plan-pricing__label">Add-on pricing by plan</div>
          <div class="addon-plan-pricing__chips">
            <div class="addon-chip">
              <span class="addon-chip__plan">Starter</span>
              <span class="addon-chip__price">+$139<span class="addon-chip__period">/agent/mo</span></span>
            </div>
            <div class="addon-chip">
              <span class="addon-chip__plan">Pro</span>
              <span class="addon-chip__price">+$129<span class="addon-chip__period">/agent/mo</span></span>
            </div>
            <div class="addon-chip">
              <span class="addon-chip__plan">Growth</span>
              <span class="addon-chip__price">+$119<span class="addon-chip__period">/agent/mo</span></span>
            </div>
            <div class="addon-chip">
              <span class="addon-chip__plan">Scale</span>
              <span class="addon-chip__price">+$119<span class="addon-chip__period">/agent/mo</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stop Monitoring Manually -->
  <section class="section signals-section">
    <div class="container">
      <div class="section-header section-header--center">
        <h2>Stop monitoring signals <span class="accent-word">manually.</span></h2>
        <p>Recruiters use 4–5 separate tools to track what Flynt monitors automatically — and spend 4 hours every morning doing it.</p>
      </div>
      <div class="table-wrap">
        <table class="compare-table signals-table">
          <thead>
            <tr>
              <th class="compare-table__feature">Signal</th>
              <th>Manual Tools Required</th>
              <th>Monthly Cost</th>
              <th>Daily Research Time</th>
              <th class="compare-table__featured">Included in Flynt</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="compare-table__feature">
                <strong>Hiring Activity</strong>
                <span class="signal-sub">Roles posted within the last 24 hrs.</span>
              </td>
              <td>
                <div class="signal-tools">
                  <span class="signal-tool-tag">LinkedIn Sales Navigator</span>
                  <span class="signal-tool-tag">Indeed / Job Boards</span>
                  <span class="signal-tool-tag">Manual daily scanning</span>
                </div>
              </td>
              <td class="signals-td--cost">
                <span class="signal-cost">$150/mo</span>
                <span class="signal-cost-note">Sales Nav required</span>
              </td>
              <td class="signals-td--time">
                <span class="signal-time">45 min/day</span>
                <span class="signal-time-note">Across multiple boards</span>
              </td>
              <td class="compare-table__featured signals-td--flynt">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="var(--purple)"/><path d="M7.5 12l3.5 3.5 5.5-5.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </td>
            </tr>
            <tr>
              <td class="compare-table__feature">
                <strong>Funding Announcements</strong>
                <span class="signal-sub">Series A / B / C rounds closed</span>
              </td>
              <td>
                <div class="signal-tools">
                  <span class="signal-tool-tag">Crunchbase Pro</span>
                  <span class="signal-tool-tag">Google Alerts</span>
                  <span class="signal-tool-tag">TechCrunch RSS</span>
                </div>
              </td>
              <td class="signals-td--cost">
                <span class="signal-cost">$49–$99/mo</span>
                <span class="signal-cost-note">Crunchbase Pro</span>
              </td>
              <td class="signals-td--time">
                <span class="signal-time">25 min/day</span>
                <span class="signal-time-note">Noisy, unreliable alerts</span>
              </td>
              <td class="compare-table__featured signals-td--flynt">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="var(--purple)"/><path d="M7.5 12l3.5 3.5 5.5-5.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </td>
            </tr>
            <tr>
              <td class="compare-table__feature">
                <strong>Leadership Changes</strong>
                <span class="signal-sub">New VP / Director / C-suite joins</span>
              </td>
              <td>
                <div class="signal-tools">
                  <span class="signal-tool-tag">LinkedIn Sales Navigator</span>
                  <span class="signal-tool-tag">LinkedIn Job Change Alerts</span>
                  <span class="signal-tool-tag">Manual profile tracking</span>
                </div>
              </td>
              <td class="signals-td--cost">
                <span class="signal-cost">$150/mo</span>
                <span class="signal-cost-note">Sales Nav required</span>
              </td>
              <td class="signals-td--time">
                <span class="signal-time">30 min/day</span>
                <span class="signal-time-note">Reviewing alert backlog</span>
              </td>
              <td class="compare-table__featured signals-td--flynt">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="var(--purple)"/><path d="M7.5 12l3.5 3.5 5.5-5.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </td>
            </tr>
            <tr>
              <td class="compare-table__feature">
                <strong>Contract Wins &amp; Expansion</strong>
                <span class="signal-sub">New contracts, offices, or product launches</span>
              </td>
              <td>
                <div class="signal-tools">
                  <span class="signal-tool-tag">Google Alerts</span>
                  <span class="signal-tool-tag">PR Newswire</span>
                  <span class="signal-tool-tag">Manual news searches</span>
                </div>
              </td>
              <td class="signals-td--cost">
                <span class="signal-cost">$0</span>
                <span class="signal-cost-note signal-cost-note--warn">Free but highly unreliable</span>
              </td>
              <td class="signals-td--time">
                <span class="signal-time">25 min/day</span>
                <span class="signal-time-note">High noise, low signal</span>
              </td>
              <td class="compare-table__featured signals-td--flynt">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="var(--purple)"/><path d="M7.5 12l3.5 3.5 5.5-5.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
