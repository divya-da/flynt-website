---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Search — See Your Market Before You Trust It | Flynt AI"
  description="Type who you're going after and Flynt searches live job postings, funding rounds and acquisitions in your market right now. Real companies, real decision makers, scored and ready."
>

<!-- ─────────────────────────────────────────────
  SECTION 1 — HERO
───────────────────────────────────────────── -->
<section class="fp-hero">
  <div class="container">
    <div class="fp-hero__inner fade-up fade-up-1">
      <div class="tag fade-up fade-up-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Search — Live in Flynt 3.0
      </div>
      <h1 class="fp-hero__headline fade-up fade-up-2">
        See your market<br />before you trust it<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">to anyone.</span>
      </h1>
      <p class="fp-hero__sub fade-up fade-up-3">
        Type who you're going after and Flynt searches live job postings, funding rounds and acquisitions in your market right now. Real companies, real decision makers, scored against your criteria, with the outreach already written. Nothing to configure. No agent needed.
      </p>
      <div class="fp-hero__ctas fade-up fade-up-4">
        <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Search Your Market Free →</a>
        <button class="btn btn--outline btn--lg" data-demo-trigger>See How It Works →</button>
      </div>
      <div class="fp-trust fade-up fade-up-4">
        <span>✓ No setup</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ No agent needed</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ Results in minutes</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ Every plan including Lite</span>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2 — THE HONEST PROBLEM
───────────────────────────────────────────── -->
<section class="section fs-problem">
  <div class="container">
    <div class="fs-problem__inner">
      <div class="tag" style="margin-bottom: 20px;">The Honest Problem</div>
      <h2>Nobody wants to configure<br />a robot on faith.</h2>
      <div class="fs-problem__body">
        <p>Every automated prospecting tool asks for the same leap: tell it what you want, trust it to go find it, come back tomorrow. If you've been burned by a data vendor, that's a lot to ask before you've seen a single company.</p>
        <p>So Flynt lets you do it by hand first. Search your market, look at what comes back, change the filters, search again. When it's returning companies you'd actually call, save it as an agent and let it run every morning. <strong>The automation is the reward, not the entry fee.</strong></p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 3 — SEARCH vs AGENT
───────────────────────────────────────────── -->
<section class="section fs-compare-section">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">Search and Agents</div>
      <h2>An agent is a search<br />you've stopped running by hand.</h2>
      <p style="max-width: 720px;">They are not two products. They are the same engine, with you holding the controls or not. Most recruiters use both: Search when they want to look, agents for markets they already know work.</p>
    </div>

    <div class="fs-compare">

      <div class="fs-compare__card fs-compare__card--light">
        <div class="fs-compare__card-header">
          <div class="fs-compare__icon fs-compare__icon--purple">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.4" stroke="#ffffff" stroke-width="1.8"/><path d="M12.2 12.2L16 16" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <div>
            <div class="fs-compare__card-title">Search</div>
            <div class="fs-compare__card-sub">You run it</div>
          </div>
        </div>
        <dl class="fs-compare__list">
          <div class="fs-compare__row">
            <dt>When it runs</dt>
            <dd>Whenever you type a search. Results in minutes.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Who decides</dt>
            <dd>You, at every stage: which companies, which hiring managers, which messages go out.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>You see</dt>
            <dd>Results live. Change the filters and run it again as many times as you want.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Best for</dt>
            <dd>A market you haven't tried, a client who calls at 4pm, a job title you've never recruited for.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Available on</dt>
            <dd><strong>Every plan, including Lite</strong></dd>
          </div>
        </dl>
      </div>

      <div class="fs-compare__card fs-compare__card--dark">
        <div class="fs-compare__card-header">
          <div class="fs-compare__icon fs-compare__icon--ghost">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6.6" stroke="#ffffff" stroke-width="1.8"/><path d="M9 5.3V9l2.6 1.7" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div>
            <div class="fs-compare__card-title fs-compare__card-title--white">Agent</div>
            <div class="fs-compare__card-sub fs-compare__card-sub--green">It runs itself</div>
          </div>
        </div>
        <dl class="fs-compare__list fs-compare__list--dark">
          <div class="fs-compare__row">
            <dt>When it runs</dt>
            <dd>Every morning on a schedule, plus any time you hit run. No daily limit.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Who decides</dt>
            <dd>You set what it looks for. It picks within those rules and shows its reasoning on every lead.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>You see</dt>
            <dd>A finished list waiting before you open your laptop, up to 30 scored leads per run.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Best for</dt>
            <dd>A market you have already proved by hand and want covered every single day.</dd>
          </div>
          <div class="fs-compare__row">
            <dt>Available on</dt>
            <dd><strong>Starter and above</strong></dd>
          </div>
        </dl>
      </div>

    </div>

    <div class="fs-compare__note">
      <p><strong>Same engine, same results, same scoring.</strong> An agent does not find different companies from a search. It runs the search you built, on the days you are not thinking about it.</p>
      <p>Which is why you can open any agent and see the exact search behind it, change one filter, and watch tomorrow's list change with it.</p>
    </div>

  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 4 — EVERY RESULT
───────────────────────────────────────────── -->
<section class="section fp-intel">
  <div class="container">
    <div class="section-header section-header--center">
      <div class="tag" style="margin: 0 auto 16px;">Every Result</div>
      <h2>Not a contact list.<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">A shortlist with reasons attached.</span></h2>
    </div>
    <div class="fp-cards">
      <div class="fp-card">
        <h3 class="fp-card__title">Companies hiring right now</h3>
        <p class="fp-card__desc">From postings that went live in the last 24 hours, not a database snapshot.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">The decision maker</h3>
        <p class="fp-card__desc">The person most likely to own the hire, scored for how well they match your criteria.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Contact details</h3>
        <p class="fp-card__desc">Verified email, phone number and LinkedIn profile.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Why it scored</h3>
        <p class="fp-card__desc">A written breakdown against role, location, seniority, company size, funding and industry.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Recent company news</h3>
        <p class="fp-card__desc">Funding, acquisitions and leadership changes, surfaced as context you can open with.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">The outreach, already written</h3>
        <p class="fp-card__desc">AI personalization built from their own job posting, which you read and edit before anything sends.</p>
      </div>
    </div>
    <div class="fs-contacted-banner">
      <div>
        <h3>Companies you've already contacted are hidden.</h3>
        <p>Automatically, on every search. You never approach the same company twice, and you never have to remember who you emailed last month.</p>
      </div>
      <span class="fs-new-badge">NEW IN 3.0</span>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 5 — SIGNAL SEARCH
───────────────────────────────────────────── -->
<section class="section fs-signal-section">
  <div class="container">
    <div class="fs-signal">
      <div class="fs-signal__left">
        <div class="tag" style="margin-bottom: 20px;">Signal Search</div>
        <h2>Search the news,<br />not just the job boards.</h2>
        <p>Switch the search to funding and M&amp;A and Flynt finds the companies in your market that just raised or just got acquired — with the same decision makers, the same scoring and the same written outreach.</p>
        <p>New money usually means new headcount. An acquisition usually means backfills and new structure. Both are reasons to call before a job is posted.</p>
        <div class="fs-signal__note">
          Available on every plan. The Signal Agent that watches for these every day is included on Pro, or a $49 add-on on Starter.
        </div>
      </div>
      <div class="fs-signal__right">
        <div class="fs-signal__card">
          <div class="fs-signal__card-row">
            <span class="fs-signal__badge">Just raised funding</span>
            <span class="fs-signal__card-meta">Announced 2 days ago</span>
          </div>
          <div class="fs-signal__company">
            <div class="fs-signal__company-name">Lumora Health</div>
            <div class="fs-signal__company-sub">Health tech · Austin, TX · $28M Series B</div>
          </div>
          <div class="fs-signal__divider"></div>
          <div class="fs-signal__detail">
            <span class="fs-signal__label">Decision Maker</span>
            <span>Daniel Okafor · VP of Engineering</span>
          </div>
          <div class="fs-signal__divider"></div>
          <div class="fs-signal__detail">
            <span class="fs-signal__label">Personalization Hook</span>
            <p class="fs-signal__hook">"Congrats on the Series B, Daniel. Doubling engineering in a year is a big lift. Want help finding senior hires who can ramp fast?"</p>
          </div>
          <span class="fs-signal__disclaimer">Sample card for illustration. Company and person are fictional.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 6 — STEP BY STEP
───────────────────────────────────────────── -->
<section class="section fs-steps-section">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">Step by Step</div>
      <h2>You decide at every stage.<br />Not just at the end.</h2>
      <p style="max-width: 720px;">An agent hands you thirty leads it already chose. Search hands you the controls. You see the companies before you pick them, the hiring managers before you target them, and the message before it sends.</p>
    </div>
    <div class="fs-steps-list">
      <div class="fs-step-row">
        <span class="fs-step-num">01</span>
        <div class="fs-step-content">
          <div class="fs-step-title">Companies</div>
          <div class="fs-step-desc">Every company in your market hiring right now, from postings that went live in the last 24 hours. Ones you've already contacted are left out.</div>
        </div>
        <span class="fs-step-action">You pick the ones worth pursuing</span>
      </div>
      <div class="fs-step-row">
        <span class="fs-step-num">02</span>
        <div class="fs-step-content">
          <div class="fs-step-title">Hiring managers</div>
          <div class="fs-step-desc">The people at those companies who could own the hire, each scored against your criteria with the reasoning written out.</div>
        </div>
        <span class="fs-step-action">You choose who to go after</span>
      </div>
      <div class="fs-step-row">
        <span class="fs-step-num">03</span>
        <div class="fs-step-content">
          <div class="fs-step-title">Contact details and context</div>
          <div class="fs-step-desc">Verified email, phone and LinkedIn, plus recent company news — pulled only for the people you selected.</div>
        </div>
        <span class="fs-step-action">You spend only on who you keep</span>
      </div>
      <div class="fs-step-row">
        <span class="fs-step-num">04</span>
        <div class="fs-step-content">
          <div class="fs-step-title">The message</div>
          <div class="fs-step-desc">AI personalization written from their own job posting and recent news, shown to you in full before anything leaves.</div>
        </div>
        <span class="fs-step-action">You read and edit it first</span>
      </div>
      <div class="fs-step-row fs-step-row--last">
        <span class="fs-step-num fs-step-num--accent">05</span>
        <div class="fs-step-content">
          <div class="fs-step-title">The campaign</div>
          <div class="fs-step-desc">Add the leads you kept to a sequence in one click, on email and LinkedIn. Or save the whole search and run it again next week.</div>
        </div>
        <span class="fs-step-action fs-step-action--green">You decide what goes out</span>
      </div>
    </div>
    <div class="fs-steps-close">
      <p><strong>Nothing is chosen for you and nothing is hidden.</strong> If a search isn't returning the leads you want, you can see exactly which stage to change.</p>
      <p>That's also what makes the agent trustworthy later. It runs the search you already tuned by hand.</p>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 7 — FROM SEARCH TO AGENT (dark)
───────────────────────────────────────────── -->
<section class="positioning fs-to-agent">
  <div class="container">
    <div class="fp-config__header">
      <div class="tag fp-dark-tag">From Search to Agent</div>
      <h2 class="fp-dark-h2">Find a search that works.<br /><span style="-webkit-text-stroke:0; color: #dbb6f8;">Then stop doing it.</span></h2>
      <p class="fp-dark-sub">Once a search is returning companies you'd actually call, there's no reason to keep typing it. One click turns it into an agent, and everything above keeps working the same way.</p>
    </div>
    <div class="fp-steps">
      <div class="fp-step">
        <div class="fp-step__num">01</div>
        <h3 class="fp-step__title">Search</h3>
        <p class="fp-step__body">Type what you're after. Adjust industries, titles, company size, geography. Run it again as many times as you want.</p>
      </div>
      <div class="fp-step">
        <div class="fp-step__num">02</div>
        <h3 class="fp-step__title">Save it</h3>
        <p class="fp-step__body">Keep any search you want to come back to. Fine-tune it later as your market shifts.</p>
      </div>
      <div class="fp-step">
        <div class="fp-step__num">03</div>
        <h3 class="fp-step__title">Make it an agent</h3>
        <p class="fp-step__body">One click and that saved search runs every morning, delivering up to 30 scored leads per run. You can still open it and change it whenever you like.</p>
      </div>
    </div>
    <p class="fs-agent-note">Every agent in Flynt is a saved search. That's why you can always see exactly what yours is looking for.</p>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 8 — CREDITS
───────────────────────────────────────────── -->
<section class="section fs-credits-section">
  <div class="container">
    <div class="fs-credits">
      <div class="fs-credits__left">
        <div class="tag" style="margin-bottom: 16px;">Credits</div>
        <h3>Search as much as you like.<br />You pay for what you use.</h3>
        <p>No daily search limit and no per-search fee. Every plan comes with a monthly credit balance, every action shows its cost before you spend it, and you can top up any time. On Lite's 2,500 credits that's around 528 fully worked leads a month: found, enriched, written and sent on email and LinkedIn.</p>
      </div>
      <a href="/pricing" class="btn btn--outline">See pricing →</a>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 9 — FINAL CTA
───────────────────────────────────────────── -->
<section class="final-cta">
  <div class="container">
    <div class="final-cta__inner">
      <h2>Your market is hiring right now.<br />Go look.</h2>
      <p>One search, five minutes, no setup. If you like what comes back, the agent is one click away.</p>
      <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Search Your Market Free →</a>
      <span class="final-cta__disclaimer">7 days free with 500 credits. Cancel anytime.</span>
    </div>
  </div>
</section>

</Layout>

<style>
/* ────────────────────────────────────────────
   SHARED — reused from feature page pattern
──────────────────────────────────────────── */
.positioning {
  position: relative;
  background: linear-gradient(to top right, #1e0a3c 0%, #3b1580 50%, #5b21b6 100%);
  padding: 80px 24px;
}

.positioning .container {
  display: flex;
  flex-direction: column;
  gap: 56px;
  position: relative;
  z-index: 2;
}

.fp-dark-tag {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.9);
  margin-bottom: 20px;
}

.fp-dark-h2 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin: 0 0 16px;
  -webkit-text-stroke: 0.6px #fff;
  max-width: 680px;
}

.fp-dark-sub {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  max-width: 580px;
  margin: 0;
  font-weight: 400;
}

.fp-config__header {
  margin-bottom: 48px;
}

.fp-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.fp-step {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  padding: 28px 32px;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.fp-step:hover {
  background: rgba(255,255,255,0.09);
  border-color: rgba(255,255,255,0.2);
  transform: translateY(-4px);
}

.fp-step__num {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 800;
  color: var(--purple-300);
  line-height: 1;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.fp-step__title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 10px;
  -webkit-text-stroke: 0;
  line-height: 1.3;
}

.fp-step__body {
  font-size: 1rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin: 0;
  font-weight: 400;
}

.fp-intel {
  background: #fff;
}

.fp-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.fp-card {
  background: #fff;
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  border-left: 4px solid var(--purple-200);
  box-shadow: var(--shadow-sm);
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.fp-card:hover {
  border-left-color: var(--purple);
  box-shadow: var(--shadow-purple);
  transform: translateY(-3px);
}

.fp-card__title {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--slate-900);
  margin: 0 0 8px;
  -webkit-text-stroke: 0;
}

.fp-card__desc {
  font-size: 0.975rem;
  color: var(--slate-600);
  line-height: 1.65;
  margin: 0;
  font-weight: 400;
}

.final-cta {
  position: relative;
  background: var(--slate-50);
  padding: 96px 24px;
}

.final-cta__inner {
  max-width: var(--max-width);
  margin: 0 auto;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.final-cta__inner h2 {
  color: var(--black);
  font-size: clamp(2rem, 4vw, 3.2rem);
  max-width: 680px;
}

.final-cta__inner p {
  color: var(--slate-600);
  font-size: 1.125rem;
  max-width: 480px;
  line-height: 1.625;
}

.final-cta__disclaimer {
  font-size: 0.875rem;
  color: var(--slate-500);
}

/* ────────────────────────────────────────────
   HERO
──────────────────────────────────────────── */
.fp-hero {
  padding: 100px 0 80px;
  overflow: hidden;
  background:
    radial-gradient(ellipse 40% 100% at 100% 0%, rgba(140,85,235,0.5) 0%, transparent 100%),
    #fff;
}

.fp-hero__inner {
  max-width: 760px;
}

.fp-hero__headline {
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 20px 0 24px;
  color: var(--black);
}

.fp-hero__sub {
  font-size: 1.2rem;
  font-weight: 500;
  color: var(--slate-600);
  line-height: 1.7;
  margin: 0 0 32px;
  max-width: 680px;
}

.fp-hero__ctas {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.fp-trust {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 6px;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--slate-500);
}

.fp-trust__dot {
  color: var(--slate-300);
}

/* ────────────────────────────────────────────
   HONEST PROBLEM
──────────────────────────────────────────── */
.fs-problem {
  background: var(--slate-50);
}

.fs-problem__inner {
  max-width: 760px;
}

.fs-problem__inner h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  line-height: 1.15;
  margin: 0 0 28px;
}

.fs-problem__body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fs-problem__body p {
  font-size: 1.1rem;
  line-height: 1.75;
  color: var(--slate-600);
  margin: 0;
}

.fs-problem__body strong {
  color: var(--slate-900);
}

/* ────────────────────────────────────────────
   SEARCH vs AGENT COMPARE
──────────────────────────────────────────── */
.fs-compare-section {
  background: #fff;
}

.fs-compare {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 20px;
}

.fs-compare__card {
  border-radius: 14px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.fs-compare__card--light {
