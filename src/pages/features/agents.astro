  font-weight: 400;
}

.fp-agent-card__body {
  font-size: 0.975rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  margin: 0;
  font-weight: 400;
}

/* ────────────────────────────────────────────
   THE TIME YOU GET BACK
──────────────────────────────────────────── */
.fp-time-section {
  background: var(--purple-bg);
}

.fp-time-header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 56px;
}

.fp-time-header__left h2 {
  margin: 0;
}

.fp-time-header__right p {
  font-size: 1.15rem;
  color: var(--slate-600);
  line-height: 1.625;
  margin: 0;
}

.fp-time-compare {
  display: grid;
  grid-template-columns: 1fr 120px 1fr;
  gap: 0;
  align-items: center;
  margin-bottom: 56px;
}

/* VS divider — matches .new-shift__shift-col */
.fp-time-vs {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  position: relative;
  z-index: 5;
}

.fp-time-vs-btn {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--purple);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  position: relative;
  box-shadow:
    0 0 0 6px rgba(255, 255, 255, 0.8),
    0 4px 20px rgba(124, 58, 237, 0.35);
}

.fp-time-vs-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid rgba(124, 58, 237, 0.45);
  animation: shift-ring-grow 2.5s ease-out infinite;
}

.fp-time-vs-label {
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--purple-900);
}

/* Column headers */
.fp-time-col-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.fp-time-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.fp-time-dot--off {
  background: var(--slate-300);
}

.fp-time-dot--on {
  background: var(--purple);
}

.fp-time-col--without .fp-time-col-label {
  color: var(--slate-500);
}

.fp-time-col--with .fp-time-col-label {
  color: var(--purple-900);
}

/* Without Flynt column — matches .new-shift__card--old */
.fp-time-col--without {
  background: var(--white);
  border: 1px dashed #b0bec9;
  border-radius: var(--radius-lg);
  padding: 36px;
  align-self: stretch;
  display: flex;
  flex-direction: column;
}

.fp-time-list {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.fp-time-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--slate-100);
}

.fp-time-list li:last-child {
  border-bottom: none;
}

.fp-time-tool {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.fp-time-tool-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--slate-100);
  color: var(--slate-500);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  flex-shrink: 0;
}

.fp-time-tool-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--slate-800);
  line-height: 1.3;
}

.fp-time-tool-sub {
  font-size: 0.8rem;
  color: var(--slate-400);
  margin-top: 2px;
  line-height: 1.3;
}

.fp-time-badge {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--slate-500);
  background: var(--slate-100);
  border-radius: 6px;
  padding: 4px 10px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* With Flynt column — matches .new-shift__card--new, purple shading, no left border */
.fp-time-col--with {
  background:
    linear-gradient(to bottom, rgba(199, 182, 250, 0.13) 0%, transparent 38%),
    var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-lg);
  padding: 36px;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.16), 0 6px 24px rgba(0, 0, 0, 0.09);
  align-self: start;
}

.fp-time-leads {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.fp-time-leads li {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 0;
  border-bottom: 1px solid var(--slate-100);
}

.fp-time-leads li:last-child {
  border-bottom: none;
}

.fp-time-lead--muted {
  opacity: 0.45;
}

.fp-time-score {
  width: 46px;
  height: 46px;
  border-radius: 10px;
  background: var(--purple);
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: -0.01em;
}

.fp-time-score--muted {
  background: var(--slate-200);
  color: var(--slate-500);
  font-weight: 500;
  font-size: 1rem;
  letter-spacing: 0.1em;
}

.fp-time-lead-name {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--slate-900);
  line-height: 1.3;
}

.fp-time-lead-name--muted {
  color: var(--slate-400);
  font-weight: 500;
}

.fp-time-lead-meta {
  font-size: 0.78rem;
  color: var(--slate-500);
  margin-top: 3px;
  line-height: 1.4;
}

.fp-time-signal {
  display: inline;
  font-weight: 600;
  color: var(--purple-900);
  background: var(--purple-bg-2);
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 0.72rem;
}

/* Daily totals */
.fp-time-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 10px;
  padding: 16px 20px;
  margin-top: 4px;
}

.fp-time-total--without {
  background: var(--slate-50);
  border: 1px solid var(--slate-200);
}

.fp-time-total--with {
  background: var(--purple-bg-2);
  border: 1px solid rgba(124, 58, 237, 0.15);
}

.fp-time-total-label {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--slate-500);
}

.fp-time-total--with .fp-time-total-label {
  color: var(--purple-900);
}

.fp-time-total-right {
  text-align: right;
}

.fp-time-total-num {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--slate-700);
  letter-spacing: -0.02em;
  line-height: 1;
  display: block;
}

.fp-time-total-num--accent {
  color: var(--purple);
}

.fp-time-total-sub {
  font-size: 0.72rem;
  color: var(--slate-400);
  margin-top: 3px;
}

.fp-time-total-sub--accent {
  color: var(--purple-900);
  opacity: 0.7;
}

/* Stat cards */
.fp-time-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.fp-time-stat {
  background: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-lg);
  padding: 32px 36px;
  text-align: center;
  border-top: 3px solid var(--purple-200);
}

.fp-time-stat-num {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: 10px;
}

.fp-time-stat-num--accent {
  color: var(--purple);
}

.fp-time-stat-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--slate-900);
  margin-bottom: 6px;
}

.fp-time-stat-desc {
  font-size: 0.875rem;
  color: var(--slate-500);
  line-height: 1.55;
}

/* ────────────────────────────────────────────
/* ────────────────────────────────────────────
   SEARCH vs AGENT COMPARE
──────────────────────────────────────────── */
.fs-compare-section {
  background: var(--slate-50);
}

.fs-compare {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 20px;
}

.fs-compare__card {
  border-radius: 20px;
  padding: 36px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.fs-compare__card--light {
  background: var(--white);
  border: 1px solid var(--slate-200);
}

.fs-compare__card--dark {
  background:
    linear-gradient(to bottom, rgba(199, 182, 250, 0.18) 0%, transparent 40%),
    var(--white);
  border: 1px solid var(--purple-300);
  box-shadow: 0 24px 64px rgba(0,0,0,0.1), 0 6px 24px rgba(0,0,0,0.06);
}

.fs-compare__card-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.fs-compare__icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fs-compare__icon--purple {
  background: var(--purple);
}

.fs-compare__icon--ghost {
  background: var(--purple);
}

.fs-compare__card-title {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.015em;
  -webkit-text-stroke: 0;
}

.fs-compare__card-title--white {
  color: var(--slate-900);
}

.fs-compare__card-sub {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--purple-900);
  margin-top: 2px;
}

.fs-compare__card-sub--green {
  color: var(--purple-dark);
}

.fs-compare__list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
}

.fs-compare__row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 8px 16px;
  align-items: baseline;
  padding: 12px 0;
  border-bottom: 1px solid var(--slate-100);
}

.fs-compare__row:first-child { padding-top: 0; }
.fs-compare__row:last-child { border-bottom: none; padding-bottom: 0; }

.fs-compare__list dt {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate-400);
  padding-top: 3px;
}

.fs-compare__list dd {
  font-size: 0.95rem;
  line-height: 1.55;
  color: var(--slate-700);
  margin: 0;
}

.fs-compare__list--dark .fs-compare__row {
  border-bottom-color: var(--purple-200);
}

.fs-compare__list--dark dt {
  color: var(--purple-dark);
}

.fs-compare__list--dark dd {
  color: var(--slate-700);
}

.fs-compare__list--dark strong {
  color: var(--purple-900);
}

.fs-compare__note {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: center;
  padding: 22px 28px;
  border-radius: 13px;
  background: var(--purple-bg);
  border: 1px solid var(--purple-bg-2);
}

.fs-compare__note p {
  flex: 999 1 380px;
  min-width: 0;
  margin: 0;
  font-size: 1rem;
  line-height: 1.65;
  color: var(--slate-700);
}

.fs-compare__note p strong {
  color: var(--slate-900);
}

/* ────────────────────────────────────────────
   FROM SEARCH TO AGENT
──────────────────────────────────────────── */
.fs-agent-note {
  font-size: 1.05rem;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  text-align: center;
  margin: 0;
  line-height: 1.6;
}


.fp-card--link {
  display: flex;
  flex-direction: column;
  color: inherit;
  text-decoration: none;
}

.fp-card__more {
  margin-top: auto;
  padding-top: 16px;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--purple);
}

/* ────────────────────────────────────────────
   ONE AGENT, ONE MONTH (inside fp-predictable)
──────────────────────────────────────────── */
.fp-oaom {
  background: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 40px;
}

.fp-oaom__header {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px 16px;
}

.fp-oaom__label {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate-500);
  flex: 1;
}

.fp-oaom__meta {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--purple-dark);
  flex-shrink: 0;
}

.fp-oaom__bars {
  display: grid;
  grid-template-columns: repeat(30, 1fr);
  gap: 4px;
}

.fp-oaom__bar {
  height: 60px;
  border-radius: 6px;
  background: var(--purple);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
}

.fp-oaom__bar--dim {
  opacity: 0.28;
}

.fp-oaom__bar-num {
  font-size: 0.72rem;
  font-weight: 800;
  color: var(--white);
  line-height: 1;
}

.fp-oaom__bar-day {
  font-size: 0.55rem;
  font-weight: 700;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.04em;
  line-height: 1;
}

.fp-oaom__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20px 32px;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--slate-200);
}

.fp-oaom__stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex-shrink: 0;
}

.fp-oaom__stat-num {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--purple-900);
  letter-spacing: -0.03em;
  line-height: 1;
}

.fp-oaom__stat-label {
  font-size: 0.75rem;
  color: var(--slate-500);
  line-height: 1.4;
}

.fp-oaom__note {
  flex: 1;
  min-width: 220px;
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--slate-600);
  margin: 0;
  font-weight: 400;
}

/* ────────────────────────────────────────────
   FULLY AUTOMATED VOLUME
──────────────────────────────────────────── */
.fp-volume {
  background: var(--white);
}

.fp-volume__cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 20px;
}

.fp-volume__card {
  background: var(--slate-50);
  border: 1px solid var(--purple-bg-2);
  border-radius: 14px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.fp-volume__card--dark {
  background:
    linear-gradient(to bottom, rgba(199, 182, 250, 0.2) 0%, transparent 50%),
    var(--white);
  border-color: var(--purple-300);
  box-shadow: 0 8px 32px rgba(124, 58, 237, 0.08);
}

.fp-volume__dots {
  display: flex;
  gap: 6px;
}

.fp-volume__dot {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  flex-shrink: 0;
}

.fp-volume__dot--on { background: var(--purple); }
.fp-volume__dot--off { background: var(--purple-bg-2); }
.fp-volume__dot--green { background: var(--purple); }

.fp-volume__label {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--slate-500);
}

.fp-volume__label--accent { color: var(--purple-dark); }
.fp-volume__label--green { color: var(--purple-dark); }

.fp-volume__num {
  font-family: var(--font-display);
  font-size: 2.25rem;
  font-weight: 800;
  color: var(--black);
  letter-spacing: -0.03em;
  line-height: 1;
}

.fp-volume__num--white { color: var(--black); }

.fp-volume__per {
  font-size: 1rem;
  font-weight: 600;
  color: var(--slate-500);
}

.fp-volume__per--dim { color: var(--slate-500); }

.fp-volume__sub {
  font-size: 0.875rem;
  color: var(--slate-600);
  margin: 0;
}

.fp-volume__sub--light { color: var(--slate-600); }

.fp-volume__plan {
  display: inline-block;
  padding: 6px 11px;
  border-radius: 7px;
  background: var(--white);
  border: 1px solid var(--purple-bg-2);
  color: var(--purple-dark);
  font-size: 0.75rem;
  font-weight: 700;
  align-self: flex-start;
}

.fp-volume__plan--dark {
  background: var(--purple-bg-2);
  border-color: var(--purple-300);
  color: var(--purple-dark);
}

.fp-volume__info {
  display: flex;
  flex-wrap: wrap;
  background: var(--purple-bg);
  border: 1px solid var(--purple-bg-2);
  border-radius: 14px;
  overflow: hidden;
}

.fp-volume__info-divider {
  width: 1px;
  background: var(--purple-bg-2);
  flex-shrink: 0;
  align-self: stretch;
}

.fp-volume__info-col {
  flex: 1 1 300px;
  padding: 26px 30px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fp-volume__info-title {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--black);
  line-height: 1.3;
}

.fp-volume__info-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--purple);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fp-volume__info-icon--dark {
  background: var(--purple-dark);
}

.fp-volume__info-col p {
  font-size: 0.925rem;
  line-height: 1.65;
  color: var(--slate-600);
  margin: 0;
  font-weight: 400;
}

.fp-volume__info-col strong {
  color: var(--black);
}

/* ────────────────────────────────────────────
   ON AUTOPILOT
──────────────────────────────────────────── */
.fp-autopilot {
  background: var(--slate-50);
}

.fp-autopilot__steps {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-bottom: 20px;
}

.fp-autopilot__step {
  flex: 1;
  background: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: 12px;
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.fp-autopilot__step--you {
  background: linear-gradient(to bottom, var(--purple-bg) 0%, var(--white) 60%);
  border-color: var(--purple-300);
}

.fp-autopilot__arrow {
  align-self: center;
  flex-shrink: 0;
  padding: 0 6px;
  color: var(--slate-300);
  display: flex;
}

.fp-autopilot__time {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--purple);
}

.fp-autopilot__time--you {
  color: var(--purple-dark);
}

.fp-autopilot__action {
  font-size: 1rem;
  font-weight: 800;
  color: var(--black);
  -webkit-text-stroke: 0;
}

.fp-autopilot__desc {
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--slate-600);
  font-weight: 400;
  margin: 0;
}

.fp-autopilot__note {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  padding: 20px 24px;
  background: var(--purple-bg);
  border: 1px solid var(--purple-bg-2);
  border-radius: 12px;
}

.fp-autopilot__note p {
  flex: 1;
  min-width: 280px;
  margin: 0;
  font-size: 0.925rem;
  line-height: 1.6;
  color: var(--slate-600);
  font-weight: 400;
}

.fp-autopilot__note strong {
  color: var(--black);
}

.fp-autopilot__control {
  flex-shrink: 0;
  padding: 8px 14px;
  border-radius: 8px;
  background: var(--white);
  border: 1px solid var(--purple-bg-2);
  color: var(--purple-dark);
  font-size: 0.8rem;
  font-weight: 700;
}

/* ────────────────────────────────────────────
   RESPONSIVE
──────────────────────────────────────────── */
@media (max-width: 1024px) {
