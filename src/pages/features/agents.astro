---
import Layout from '../../layouts/Layout.astro';
import WhoFaq from '../../components/features/WhoFaq.astro';
import CreditsBlock from '../../components/features/CreditsBlock.astro';

const personas = [
  { title: 'Solo recruiters', body: 'Keep prospecting while you are busy placing.' },
  { title: 'Agency owners', body: 'Cover every market your team works, every single day.' },
  { title: 'Teams scaling across markets', body: "Run one agent per market and see what's working on one dashboard." },
];

const faqs = [
  { title: 'Does an agent find different leads from a search?', body: "It runs your search every day and surfaces the companies that weren't there yesterday. Always fresh, always scored, each with its own outreach written, delivered without you triggering it." },
  { title: 'Do I have to search first?', body: 'No. You can set up an agent from scratch and Flynt saves the search behind it for you. Most recruiters search first, then run the search that works.' },
  { title: 'Can I change what an agent looks for?', body: "Yes. Open the agent, see the search behind it and change a filter. Tomorrow's leads change with it." },
  { title: 'Are the leads contacted automatically?', body: "Only if you turn it on. With a campaign connected and automatic sending enabled, new leads enter your sequence on email and LinkedIn as soon as they're found. Leave it off and they land in your list to review and send yourself." },
  { title: 'Is 30 leads a day a hard cap?', body: 'Only for what arrives on schedule. One agent running on autopilot delivers up to 30 a day. Running searches yourself has no limit, and you can hit Run now on an agent any time for another batch. For more hands-off volume, add an agent: two is 60 a day, three is 90.' },
  { title: 'Which plans include agents, and which kinds?', body: 'Starter and above, and search is on every plan including Lite. There is one agent for each kind of search: hiring, signal and MPC. Run as many as your plan allows, each on its own market.' },
];
---

<Layout
  title="Agents — Your Search, Run Every Day | Flynt AI"
  description="An agent takes a search you trust and runs it every day with all of your filters and settings. Before you open your laptop, fresh leads are scored, personalised and already contacted."
>

<!-- ─────────────────────────────────────────────
  SECTION 1 — HERO
───────────────────────────────────────────── -->
<section class="fp-hero">
  <div class="container">
    <div class="fp-hero__layout">
      <div class="fp-hero__copy fade-up fade-up-1">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          Agents
        </div>
        <h1 class="fp-hero__headline">
          Your search, run every day.<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">Fresh leads, already contacted.</span>
        </h1>
        <p class="fp-hero__sub">
          An agent takes a search you trust and runs it for you every day, with all of your filters and settings. You don't have to be at your desk. Before you open your laptop, the new leads are scored, personalised and already in your campaign.
        </p>
        <div class="fp-hero__ctas">
          <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Start Free Trial →</a>
          <button class="btn btn--outline btn--lg" data-demo-trigger>See It In Action →</button>
        </div>
        <div class="fp-trust">
          <span>✓ 30 leads per agent, hands off</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ Every agent is a saved search</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ Leads contacted automatically</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ 5 min set up</span>
        </div>
      </div>

      <div class="fp-hero__visual fade-up fade-up-2">
        <div class="ag-run-card">
          <div class="ag-run-card__header">
            <span class="ag-run-card__dot"></span>
            <span class="ag-run-card__name">Nurse Managers, Washington</span>
            <span class="ag-run-card__time">RAN 06:12</span>
          </div>
          <div class="ag-run-card__stats">
            <div class="ag-run-stat">
              <span class="ag-run-stat__num">270</span>
              <span class="ag-run-stat__label">Scanned</span>
            </div>
            <div class="ag-run-stat">
              <span class="ag-run-stat__num ag-run-stat__num--purple">30</span>
              <span class="ag-run-stat__label">Qualified</span>
            </div>
            <div class="ag-run-stat">
              <span class="ag-run-stat__num ag-run-stat__num--green">30</span>
              <span class="ag-run-stat__label">Contacted</span>
            </div>
          </div>
          <div class="ag-lead-card">
            <div class="ag-lead-card__row">
              <span class="ag-lead-card__company">Meridian Capital</span>
              <span class="ag-lead-card__score">99%</span>
            </div>
            <span class="ag-lead-card__meta">Burst hire · 4 data roles · 18 days</span>
            <span class="ag-lead-card__status">Sequence started 06:31</span>
          </div>
          <div class="ag-lead-card">
            <div class="ag-lead-card__row">
              <span class="ag-lead-card__company">Veritas Growth</span>
              <span class="ag-lead-card__score">94%</span>
            </div>
            <span class="ag-lead-card__meta">Funding · Series B $22M</span>
            <span class="ag-lead-card__status">Sequence started 06:31</span>
          </div>
        </div>
        <div class="fp-hero__note">28 more delivered before 9am. Sample data.</div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2 — PREDICTABLE BY DESIGN
───────────────────────────────────────────── -->
<section class="section fp-predictable">
  <div class="container">
    <div class="fp-predictable__inner">
      <div class="fp-predictable__left">
        <div class="tag">Predictable by Design</div>
        <h2 class="fp-predictable__h2">30 leads today.<br />30 tomorrow.<br />30 the day after.</h2>
      </div>
      <div class="fp-predictable__right">
        <p>Prospecting by hand is feast or famine. You push hard for a week, land a placement, stop, and six weeks later the pipeline is empty and you're starting cold.</p>
        <p>An agent doesn't have good weeks and bad weeks. It has days, and they all look the same.</p>
      </div>
    </div>

    <!-- ONE AGENT, ONE MONTH card -->
    <div class="fp-oaom">
      <div class="fp-oaom__header">
        <span class="fp-oaom__label">One Agent, One Month</span>
        <span class="fp-oaom__meta">30 runs · 30 batches · no gaps</span>
      </div>
      <div class="fp-oaom__bars">
        {(() => {
          const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
          return Array.from({length: 30}).map((_, i) => {
            const isWeekend = i % 7 === 5 || i % 7 === 6;
            return (
              <span class={`fp-oaom__bar${isWeekend ? ' fp-oaom__bar--dim' : ''}`}>
                <span class="fp-oaom__bar-num">30</span>
                <span class="fp-oaom__bar-day">{days[i % 7]}</span>
              </span>
            );
          });
        })()}
      </div>
      <div class="fp-oaom__stats">
        <div class="fp-oaom__stat">
          <span class="fp-oaom__stat-num">~900</span>
          <span class="fp-oaom__stat-label">new opportunities a month, per agent</span>
        </div>
        <div class="fp-oaom__stat">
          <span class="fp-oaom__stat-num">0</span>
          <span class="fp-oaom__stat-label">days you had to remember to prospect</span>
        </div>
        <p class="fp-oaom__note">Whether you were busy, travelling, on a client call or closing a placement. Consistency is the genuinely hard part of business development, and it's the part an agent is best at.</p>
      </div>
    </div>

  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION: FULLY AUTOMATED VOLUME
───────────────────────────────────────────── -->
<section class="section fp-volume">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">Fully Automated Volume</div>
      <h2>Thirty a day is one agent.<br />Add another for sixty.</h2>
      <p style="max-width: 720px;">Thirty leads a day is what a single agent delivers on its own, while you're doing something else entirely. That's the number that matters for autopilot, because it arrives without you touching anything. Want more arriving the same way? Add an agent. Each one runs its own search on its own schedule.</p>
    </div>

    <div class="fp-volume__cards">
      <div class="fp-volume__card">
        <div class="fp-volume__dots">
          <span class="fp-volume__dot fp-volume__dot--on"></span>
          <span class="fp-volume__dot fp-volume__dot--off"></span>
          <span class="fp-volume__dot fp-volume__dot--off"></span>
        </div>
        <div class="fp-volume__label">1 Agent</div>
        <div><span class="fp-volume__num">30</span><span class="fp-volume__per">/day</span></div>
        <div class="fp-volume__sub">around 900 a month, hands off</div>
        <span class="fp-volume__plan">Starter and above</span>
      </div>
      <div class="fp-volume__card">
        <div class="fp-volume__dots">
          <span class="fp-volume__dot fp-volume__dot--on"></span>
          <span class="fp-volume__dot fp-volume__dot--on"></span>
          <span class="fp-volume__dot fp-volume__dot--off"></span>
        </div>
        <div class="fp-volume__label fp-volume__label--accent">2 Agents</div>
        <div><span class="fp-volume__num">60</span><span class="fp-volume__per">/day</span></div>
        <div class="fp-volume__sub">around 1,800 a month, hands off</div>
        <span class="fp-volume__plan">Add a second agent</span>
      </div>
      <div class="fp-volume__card fp-volume__card--dark">
        <div class="fp-volume__dots">
          <span class="fp-volume__dot fp-volume__dot--green"></span>
          <span class="fp-volume__dot fp-volume__dot--green"></span>
          <span class="fp-volume__dot fp-volume__dot--green"></span>
        </div>
        <div class="fp-volume__label fp-volume__label--green">3 Agents</div>
        <div><span class="fp-volume__num fp-volume__num--white">90</span><span class="fp-volume__per fp-volume__per--dim">/day</span></div>
        <div class="fp-volume__sub fp-volume__sub--light">around 2,700 a month, hands off</div>
        <span class="fp-volume__plan fp-volume__plan--dark">Pro and above</span>
      </div>
    </div>

    <div class="fp-volume__info">
      <div class="fp-volume__info-col">
        <div class="fp-volume__info-title">
          <span class="fp-volume__info-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.6" stroke="#ffffff" stroke-width="1.7"/><path d="M10.5 10.5L14 14" stroke="#ffffff" stroke-width="1.7" stroke-linecap="round"/></svg>
          </span>
          By hand, there's no limit at all
        </div>
        <p>Run as many searches as you want, whenever you want. Hit <strong>Run now</strong> on any agent for another batch on the spot. Nothing caps you except your credit balance, and you can top that up any time.</p>
      </div>
      <div class="fp-volume__info-divider" aria-hidden="true"></div>
      <div class="fp-volume__info-col">
        <div class="fp-volume__info-title">
          <span class="fp-volume__info-icon fp-volume__info-icon--dark">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.8" stroke="#ffffff" stroke-width="1.7"/><path d="M8 4.8V8l2.3 1.5" stroke="#ffffff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          On schedule, it's 30 a day per agent
        </div>
        <p>That's the figure for genuine autopilot: what lands while you're asleep, in a meeting or on holiday, without you clicking anything. More hands-off volume means more agents.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION: ON AUTOPILOT
───────────────────────────────────────────── -->
<section class="section fp-autopilot">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">On Autopilot</div>
      <h2>Found, written and sent<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">before you're awake.</span></h2>
      <p style="max-width: 720px;">An agent connected to a campaign doesn't stop at the lead. It writes the outreach from that company's own posting, drops it into your sequence on email and LinkedIn, and sends. You wake up to replies, not to a to-do list.</p>
    </div>

    <div class="fp-autopilot__steps">
      <div class="fp-autopilot__step">
        <span class="fp-autopilot__time">03:00</span>
        <span class="fp-autopilot__action">Scans</span>
        <span class="fp-autopilot__desc">Every posting, round and deal that went live overnight</span>
      </div>
      <span class="fp-autopilot__arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
      <div class="fp-autopilot__step">
        <span class="fp-autopilot__time">03:12</span>
        <span class="fp-autopilot__action">Scores</span>
        <span class="fp-autopilot__desc">Against your criteria, with the reasoning written out</span>
      </div>
      <span class="fp-autopilot__arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
      <div class="fp-autopilot__step">
        <span class="fp-autopilot__time">03:25</span>
        <span class="fp-autopilot__action">Writes</span>
        <span class="fp-autopilot__desc">A different message per company, from their own posting</span>
      </div>
      <span class="fp-autopilot__arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
      <div class="fp-autopilot__step">
        <span class="fp-autopilot__time">03:40</span>
        <span class="fp-autopilot__action">Sends</span>
        <span class="fp-autopilot__desc">Into your sequence, email and LinkedIn together</span>
      </div>
      <span class="fp-autopilot__arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
      <div class="fp-autopilot__step fp-autopilot__step--you">
        <span class="fp-autopilot__time fp-autopilot__time--you">09:00</span>
        <span class="fp-autopilot__action">You read</span>
        <span class="fp-autopilot__desc">Replies in your inbox. Nothing left to do first.</span>
      </div>
    </div>

    <div class="fp-autopilot__note">
      <p><strong>Automatic sending is a switch, not a default.</strong> Leave it off and the same leads land in your list for you to review and send yourself. The agent still does everything up to that point.</p>
      <span class="fp-autopilot__control">You stay in control</span>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 3 — THE TIME YOU GET BACK
───────────────────────────────────────────── -->
<section class="section fp-time-section">
  <div class="container">

    <div class="fp-time-header">
      <div class="fp-time-header__left">
        <div class="tag" style="margin-bottom: 16px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          The Time You Get Back
        </div>
        <h2>This used to take 4 hours.<br />Now it takes <span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">zero</span>.</h2>
      </div>
      <div class="fp-time-header__right">
        <p>Every piece of intelligence in your lead package would need four separate tools and a full morning of research to gather manually. Flynt does it overnight.</p>
      </div>
    </div>

    <div class="fp-time-compare">

      <!-- WITHOUT FLYNT -->
      <div class="fp-time-col fp-time-col--without">
        <div class="fp-time-col-header">
          <span class="fp-time-dot fp-time-dot--off"></span>
          <span class="fp-time-col-label">Without Flynt</span>
        </div>
        <ul class="fp-time-list">
          <li>
            <div class="fp-time-tool">
              <div class="fp-time-tool-icon">in</div>
              <div>
                <div class="fp-time-tool-name">LinkedIn Sales Navigator</div>
                <div class="fp-time-tool-sub">Hiring patterns · leadership changes</div>
              </div>
            </div>
            <span class="fp-time-badge">60 min</span>
          </li>
          <li>
            <div class="fp-time-tool">
              <div class="fp-time-tool-icon">CB</div>
              <div>
                <div class="fp-time-tool-name">Crunchbase Pro</div>
                <div class="fp-time-tool-sub">Funding rounds · company data</div>
              </div>
            </div>
            <span class="fp-time-badge">30 min</span>
          </li>
          <li>
            <div class="fp-time-tool">
              <div class="fp-time-tool-icon">G</div>
              <div>
                <div class="fp-time-tool-name">Google Alerts</div>
                <div class="fp-time-tool-sub">Contract wins · company news</div>
              </div>
            </div>
            <span class="fp-time-badge">30 min</span>
          </li>
          <li>
            <div class="fp-time-tool">
              <div class="fp-time-tool-icon">JB</div>
              <div>
                <div class="fp-time-tool-name">Job Boards</div>
                <div class="fp-time-tool-sub">Burst hiring · open role tracking</div>
              </div>
            </div>
            <span class="fp-time-badge">60 min</span>
          </li>
          <li>
            <div class="fp-time-tool">
              <div class="fp-time-tool-icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
              </div>
              <div>
                <div class="fp-time-tool-name">Manual outreach research</div>
                <div class="fp-time-tool-sub">Writing personalisation angles per lead</div>
              </div>
            </div>
            <span class="fp-time-badge">60 min</span>
          </li>
        </ul>
        <div class="fp-time-total fp-time-total--without">
          <span class="fp-time-total-label">Daily Total</span>
          <div class="fp-time-total-right">
            <span class="fp-time-total-num">4 hrs</span>
            <div class="fp-time-total-sub">before your first call</div>
          </div>
        </div>
      </div>

      <!-- VS -->
      <div class="fp-time-vs" aria-hidden="true">
        <div class="fp-time-vs-btn">VS</div>
      </div>

      <!-- WITH FLYNT -->
      <div class="fp-time-col fp-time-col--with">
        <div class="fp-time-col-header">
          <span class="fp-time-dot fp-time-dot--on"></span>
          <span class="fp-time-col-label">With Flynt</span>
        </div>
        <ul class="fp-time-leads">
          <li>
            <div class="fp-time-score">99%</div>
            <div>
              <div class="fp-time-lead-name">Meridian Capital</div>
              <div class="fp-time-lead-meta"><span class="fp-time-signal">Burst hire</span> · 4 data roles · 18 days · sarah@meridian.com</div>
            </div>
          </li>
          <li>
            <div class="fp-time-score">94%</div>
            <div>
              <div class="fp-time-lead-name">Veritas Growth</div>
              <div class="fp-time-lead-meta"><span class="fp-time-signal">Funding</span> · Series B $22M · james@veritas.io</div>
            </div>
          </li>
          <li>
            <div class="fp-time-score">91%</div>
            <div>
              <div class="fp-time-lead-name">Athos Consulting</div>
              <div class="fp-time-lead-meta"><span class="fp-time-signal">Leadership</span> · New CTO joined 3 weeks ago</div>
            </div>
          </li>
          <li>
            <div class="fp-time-score">88%</div>
            <div>
              <div class="fp-time-lead-name">Nova Systems</div>
              <div class="fp-time-lead-meta"><span class="fp-time-signal">Contract win</span> · £4M gov contract · AI hooks ready</div>
            </div>
          </li>
          <li class="fp-time-lead--muted">
            <div class="fp-time-score fp-time-score--muted">···</div>
            <div>
              <div class="fp-time-lead-name fp-time-lead-name--muted">More leads waiting</div>
              <div class="fp-time-lead-meta">Delivered before 9am</div>
            </div>
          </li>
        </ul>
        <div class="fp-time-total fp-time-total--with">
          <span class="fp-time-total-label">Daily Total</span>
          <div class="fp-time-total-right">
            <span class="fp-time-total-num fp-time-total-num--accent">0 min</span>
            <div class="fp-time-total-sub fp-time-total-sub--accent">runs overnight while you sleep</div>
          </div>
        </div>
      </div>

    </div>

    <!-- STAT CARDS -->
    <div class="fp-time-stats">
      <div class="fp-time-stat">
        <div class="fp-time-stat-num fp-time-stat-num--accent">4 hrs</div>
        <div class="fp-time-stat-title">Back every morning</div>
        <div class="fp-time-stat-desc">Spend your time on calls, not research.</div>
      </div>
      <div class="fp-time-stat">
        <div class="fp-time-stat-num">4 → 1</div>
        <div class="fp-time-stat-title">Tools replaced</div>
        <div class="fp-time-stat-desc">LinkedIn, Crunchbase, Alerts, and job boards — in one agent.</div>
      </div>
      <div class="fp-time-stat">
        <div class="fp-time-stat-num fp-time-stat-num--accent">$1,500<sup>+</sup></div>
        <div class="fp-time-stat-title">Saved per month</div>
        <div class="fp-time-stat-desc">vs. paying for each tool separately.</div>
      </div>
    </div>

  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 5 — SEARCH vs AGENT
───────────────────────────────────────────── -->
<section class="section fs-compare-section">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">Search and Agents</div>
      <h2>An agent is a search<br />you've stopped running by hand.</h2>
      <p style="max-width: 720px;">Nobody wants to configure a robot on faith. So Flynt lets you search by hand first, change the filters, search again. When it's returning companies you'd actually call, run it daily with an agent. The automation is the reward, not the entry fee, and that's what makes the agent trustworthy: it runs the search you already tuned yourself.</p>
    </div>

    <div class="fs-compare">

      <div class="fs-compare__card fs-compare__card--light">
        <div class="fs-compare__card-header">
          <div class="fs-compare__icon fs-compare__icon--purple">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.4" stroke="#ffffff" stroke-width="1.8"/><path d="M12.2 12.2L16 16" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/></svg>
