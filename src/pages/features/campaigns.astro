---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Flynt Campaigns — Personalized Outreach at Scale"
  description="Flynt writes each message around real signals and adjusts the surrounding copy so every email reads like you wrote it. Not like a template."
>

<!-- ─────────────────────────────────────────────
  SECTION 1 — HERO
───────────────────────────────────────────── -->
<section class="fp-hero">
  <div class="container">
    <div class="fp-hero__layout">
      <div class="tag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11.5 19.79 19.79 0 0 1 1.61 2.84 2 2 0 0 1 3.6.67h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.27a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.5 15.6v1.32z"/><path d="M14.05 3a9 9 0 0 1 8 7.94"/><path d="M14.05 7A5 5 0 0 1 19 12"/></svg>
        Flynt Campaigns — Outreach at Scale
      </div>
      <h1 class="fp-hero__h1"><span class="hl">Personalized</span> outreach at scale. Without the contradiction.</h1>
      <p class="fp-hero__sub">Flynt writes each message around the actual signals – company news, career context, the specific job they posted – and adjusts the surrounding copy so every email reads like you wrote it. Not like a template. Connect your inbox, pick a sequence, and send with confidence.</p>
      <div class="fp-hero__ctas">
        <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Start Free Trial →</a>
        <button class="btn btn--outline btn--lg" data-demo-trigger>See It In Action →</button>
      </div>
      <div class="fp-trust">
        <span>✓ Connect existing inbox or create new</span>
        <span>·</span>
        <span>✓ Prebuilt sequences ready to launch</span>
        <span>·</span>
        <span>✓ AI personalization for every lead</span>
        <span>·</span>
        <span>✓ 5 min set up time</span>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2 — BEFORE / AFTER (Manual vs Campaigns)
───────────────────────────────────────────── -->
<section class="section new-shift">
  <div class="container">

    <div class="new-shift__header">
      <div class="new-shift__header-left">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          Before &amp; After
        </div>
        <h2 class="new-shift__headline">Scale or personalize. Every outreach tool makes you choose. <span class="new-shift__accent">Flynt doesn't.</span></h2>
      </div>
      <div class="new-shift__header-right">
        <p class="new-shift__lead">Here's what BD outreach has always looked like. And what it looks like now.</p>
      </div>
    </div>

    <div class="new-shift__compare">

      <!-- Left card: Manual Outreach -->
      <div class="new-shift__card new-shift__card--old">
        <div class="ns-badge ns-badge--old">
          <span class="ns-badge-icon ns-badge-icon--x">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </span>
          Manual Outreach
        </div>
        <h3 class="ns-card-title">20 good emails. Or 200 generic ones. That's the choice.</h3>
        <hr class="ns-divider" />
        <ul class="ns-list ns-list--old">
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Personalize 20 emails by hand. Takes two hours before a single send.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Follow up? Someone has to remember, go back, and do it manually.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Want a new inbox? New domain? IT ticket, setup time, warming period.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Hit your daily send limit. Start fresh tomorrow.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Scale up – personalization goes down. Every message reads like a template.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            20 good emails. Or 200 generic ones. That's the choice.
          </li>
        </ul>
      </div>

      <!-- Shift column -->
      <div class="new-shift__shift-col" aria-hidden="true">
        <div class="new-shift__shift-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <span class="new-shift__shift-label">The Shift</span>
      </div>

      <!-- Right card: Flynt Campaigns -->
      <div class="new-shift__card new-shift__card--new">
        <div class="ns-badge ns-badge--new">
          <span class="ns-badge-icon ns-badge-icon--check">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          Flynt Campaigns
        </div>
        <h3 class="ns-card-title">200 emails. Everyone personalized. The choice is gone.</h3>
        <hr class="ns-divider" />
        <ul class="ns-list ns-list--new">
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Flynt personalizes every email automatically – hook written, copy adjusted, reads naturally.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Sequence follows up automatically. Every step, every lead, no manual tracking.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Create a new inbox and domain inside Flynt in minutes. Warmed and ready.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            No ceiling. Send at whatever scale your pipeline demands.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Scale up – personalization stays. Every message still reads like you wrote it specifically for them.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            200 emails. Everyone personalized. The choice is gone.
          </li>
        </ul>
      </div>

    </div>

    <div class="new-shift__close">
      <div class="new-shift__close-divider">
        <span class="new-shift__close-line"></span>
        <div class="new-shift__close-icon">
          <img src="/images/logo-mark.svg" alt="" width="28" height="28" />
        </div>
        <span class="new-shift__close-line new-shift__close-line--right"></span>
      </div>
      <p>Most outreach either feels human or robotic — personalization has always been a manual job that takes hours.</p>
      <strong class="new-shift__close-headline">Flynt makes it automatic. The trade-off is over.</strong>
    </div>

  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2B — INBOX SETUP
───────────────────────────────────────────── -->
<section class="section fp-inbox-section">
  <div class="container">
    <div class="fp-header-split">
      <div class="fp-header-split__left">
        <div class="tag">Inbox Setup</div>
        <h2>Send from what you have. Or let <span class="hl">Flynt build it</span> for you.</h2>
      </div>
      <div class="fp-header-split__right">
        <p>Before your first email goes out, you need a place to send from. Connect your existing inbox in one click, have Flynt set up a brand new domain and mailbox from scratch, or launch instantly with a pre-warmed account — all without leaving the platform.</p>
      </div>
    </div>
    <div class="fp-inbox-grid">

      <div class="fp-inbox-card">
        <div class="fp-inbox-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </div>
        <h3 class="fp-inbox-card__title">Connect Existing</h3>
        <p class="fp-inbox-card__body">Already using Gmail or Outlook? Connect it in under a minute. Your inbox, your domain, your sending reputation — all intact.</p>
      </div>

      <div class="fp-inbox-card">
        <div class="fp-inbox-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3 class="fp-inbox-card__title">Done-For-You Setup</h3>
        <p class="fp-inbox-card__body">Want a dedicated sending domain and new inboxes? Tell Flynt what you need and it'll handle the domain, mailboxes, DNS configuration, and warmup pool. You focus on outreach. Flynt handles everything else.</p>
      </div>

      <div class="fp-inbox-card">
        <div class="fp-inbox-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3 class="fp-inbox-card__title">Pre-Warmed Accounts</h3>
        <p class="fp-inbox-card__body">Need to send emails today? Launch with fully warmed inboxes already optimized for deliverability. Premium IP reputation, ready the moment you are. No setup time, no waiting period.</p>
      </div>

    </div>
    <p class="fp-inbox-bottom">However you want to send, Flynt has it covered. Your first campaign can be live in under five minutes.</p>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 3 — INBOX DETAIL
───────────────────────────────────────────── -->
<section class="section fp-inbox-detail">
  <div class="container">
    <div class="fp-header-split">
      <div class="fp-header-split__left">
        <div class="tag">Inbox Setup</div>
        <h2>No separate tools. <span class="hl">No domain headaches.</span></h2>
      </div>
      <div class="fp-header-split__right">
        <p>Most outreach tools make you configure sending infrastructure somewhere else, then try to connect everything. In Flynt, connect your existing email inbox with one click or create a brand new inbox and domain directly inside the platform, warmed and ready to send. Everything in one place before you write a single message.</p>
      </div>
    </div>
    <div class="fp-features-grid">
      <div class="fp-feat-item">
        <h3 class="fp-feat-item__title">Connect your existing inbox instantly</h3>
        <p class="fp-feat-item__desc">Gmail, Outlook, and major providers. One click. Your sending reputation stays intact.</p>
      </div>
      <div class="fp-feat-item">
        <h3 class="fp-feat-item__title">Create a new inbox and domain inside Flynt</h3>
        <p class="fp-feat-item__desc">No external setup required. Flynt handles domain purchase, mailbox creation, and DNS configuration.</p>
      </div>
      <div class="fp-feat-item">
        <h3 class="fp-feat-item__title">Domain warming handled automatically</h3>
        <p class="fp-feat-item__desc">Flynt's warmup pool gradually builds your sending reputation so you land in inboxes, not spam.</p>
      </div>
      <div class="fp-feat-item">
        <h3 class="fp-feat-item__title">Multiple inboxes for different agents or markets</h3>
        <p class="fp-feat-item__desc">Run separate campaigns across different markets with dedicated inboxes for each.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 4 — SEQUENCE BUILDER
───────────────────────────────────────────── -->
<section class="section fp-seq-section">
  <div class="container fp-seq-layout">
    <div class="fp-seq-text">
      <div class="tag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Sequence Builder
      </div>
      <h2>Build your own. Or use one <span class="hl">Flynt already built.</span></h2>
      <p>Start from a prebuilt sequence – 6 emails, pre-written copy, proven timing – and launch in minutes. Or build from scratch with full control over every message, stage count, timing, and condition. Either way, Flynt personalizes every message before it sends.</p>
    </div>
    <div class="fp-seq-cards">
      <div class="fp-seq-card fp-seq-card--prebuilt">
        <h3 class="fp-seq-card__title">Prebuilt Sequences</h3>
        <p class="fp-seq-card__body">6-email sequences with pre-written copy. Pick one, connect your leads, launch. Done. No writing required.</p>
        <a href="https://app.tryflynt.ai/" class="fp-seq-card__link">Launch in minutes →</a>
      </div>
      <div class="fp-seq-card fp-seq-card--custom">
        <h3 class="fp-seq-card__title">Custom Builder</h3>
        <p class="fp-seq-card__body">Write every message yourself. Set your own stage count, timing, and follow-up logic. Full control, every step.</p>
        <a href="https://app.tryflynt.ai/" class="fp-seq-card__link">Build your sequence →</a>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 5 — AI PERSONALIZATION
───────────────────────────────────────────── -->
<section class="section fp-perso-section">
  <div class="container">
    <div class="fp-perso-layout">
      <div class="fp-perso-left">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          AI Personalization
        </div>
        <h2>A hook that <span class="hl">fits.</span> Not one that sticks out.</h2>
        <p>Every other tool drops a personalization line at the top and leaves the rest of the email generic. The mismatch is obvious. Flynt's AI writes the hook – pulled from company news, career trajectory, or the specific job posting – and then adjusts the surrounding copy to match. The whole email reads as one coherent message. Not a template with something pasted in.</p>
      </div>
      <div class="fp-perso-right">
        <div class="fp-perso-old">
          <p class="fp-perso__label">Generic Tool</p>
          <div class="fp-perso__line">[Personalization line]</div>
          <div class="fp-perso__line">+ [Same template body you sent 800 times]</div>
        </div>
        <div class="fp-perso-new">
          <p class="fp-perso__label">Flynt</p>
          <div class="fp-perso__line">One email, written around the person, reads naturally from first word to last</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 6 — ONE SYSTEM (dark bg)
───────────────────────────────────────────── -->
<section class="positioning fp-one-system">
  <div class="container">
    <div class="fp-header-split fp-one-system__header">
      <div class="fp-header-split__left">
        <div class="tag fp-dark-tag">Research to Reply</div>
        <h2 class="fp-dark-h2">The intelligence that found the lead powers the message that <span class="hl">reaches them.</span></h2>
      </div>
      <div class="fp-header-split__right">
        <p class="fp-dark-sub">Signal surfaces the lead, scores the fit, and writes the personalization hooks. Campaigns takes those hooks and builds them into a sequence that sends – with every message adjusted so it reads naturally from start to finish. You never move intelligence from one tool to another. It flows through the same system, from the first scan to the sent confirmation.</p>
      </div>
    </div>
    <div class="fp-flow">
      <div class="fp-flow__step">
        <div class="fp-flow__step-label">Step 1</div>
        <div class="fp-flow__step-title">Agent finds the lead</div>
      </div>
      <div class="fp-flow__arrow" aria-hidden="true">→</div>
      <div class="fp-flow__step">
        <div class="fp-flow__step-label">Step 2</div>
        <div class="fp-flow__step-title">Campaigns sends it</div>
      </div>
      <div class="fp-flow__arrow" aria-hidden="true">→</div>
      <div class="fp-flow__step">
        <div class="fp-flow__step-label">Step 3</div>
        <div class="fp-flow__step-title">CRM tracks it</div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 7 — FINAL CTA
───────────────────────────────────────────── -->
<section class="fp-final-cta">
  <div class="fp-final-cta__inner">
    <h2>Your next client is <span class="hl">already out there.</span></h2>
    <p>Set up your first campaign in under 5 minutes and send your first personalized email before lunch.</p>
    <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Start Free Trial →</a>
     <span class="final-cta__disclaimer">Cancel anytime.</span>
  </div>
</section>

</Layout>

<style>
/* ────────────────────────────────────────────
   DARK SECTIONS (.positioning)
──────────────────────────────────────────── */
.positioning {
  position: relative;
  background: linear-gradient(to top right, #1e0a3c 0%, #3b1580 50%, #5b21b6 100%);
  padding: 80px 24px;
}

.positioning .container {
  display: flex;
  flex-direction: column;
  gap: 56px;
  position: relative;
  z-index: 2;
}

/* ────────────────────────────────────────────
   HERO
──────────────────────────────────────────── */
.fp-hero {
  padding: 100px 0 80px;
  overflow: hidden;
  background:
    radial-gradient(ellipse 40% 100% at 100% 0%, rgba(140, 85, 235, 0.5) 0%, transparent 100%),
    #ffffff;
}

.fp-hero__layout {
  max-width: 700px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.fp-hero__h1 {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  font-weight: 800;
  color: var(--slate-900);
  line-height: 1.1;
  margin: 0;
  letter-spacing: -0.02em;
}

.fp-hero__sub {
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  color: var(--slate-600);
  line-height: 1.75;
  margin: 0;
}

.fp-hero__ctas {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}

.fp-trust {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.fp-trust span {
  font-size: 0.85rem;
  color: var(--slate-500);
}

/* ────────────────────────────────────────────
   NEW SHIFT — BEFORE / AFTER
──────────────────────────────────────────── */
.new-shift { background: var(--slate-50); padding-bottom: 120px; }

.new-shift__header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px 64px;
  margin-bottom: 56px;
  align-items: start;
}

.new-shift__header-left {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.new-shift__header-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-top: 92px;
}

.new-shift__headline {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 2.8vw, 2.5rem);
  font-weight: 800;
  color: var(--slate-900);
  line-height: 1.15;
  margin: 0;
}

.new-shift__accent,
.hl {
  color: var(--purple);
  -webkit-text-stroke: 0;
}

.new-shift__lead {
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  color: var(--slate-600);
  line-height: 1.7;
  font-weight: 500;
  margin: 0 0 8px;
}

.new-shift__compare {
  display: grid;
  grid-template-columns: 1fr 120px 1fr;
  align-items: center;
  margin-bottom: 40px;
}

.new-shift__card {
  border-radius: 16px;
  padding: 36px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.new-shift__card--old {
  background: var(--white);
  border: 1px dashed #b0bec9;
  align-self: stretch;
  display: flex;
  flex-direction: column;
}

.new-shift__card--new {
  background:
