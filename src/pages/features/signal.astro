---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Flynt Signal — Core Research & Lead Delivery | Flynt AI"
  description="Set your criteria once. Flynt's agents scan 250 million profiles and 30 million companies, scoring every fit and delivering a complete intelligence package to your inbox every day."
>

<!-- ─────────────────────────────────────────────
  SECTION 1 — HERO
───────────────────────────────────────────── -->
<section class="fp-hero">
  <div class="container">
    <div class="fp-hero__inner fade-up fade-up-1">
      <div class="tag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
        Flynt Signal — Core Research &amp; Lead Delivery
      </div>
      <h1 class="fp-hero__headline fade-up fade-up-2">
        Clients you want, found and delivered.<br />Every single day.
      </h1>
      <p class="fp-hero__sub fade-up fade-up-3">
        Set your criteria once. Flynt's agents scan 250 million profiles and 30 million companies finding the exact clients you're targeting, scoring every fit, and delivering a complete intelligence package to your inbox before you open your laptop.
      </p>
      <div class="fp-hero__ctas fade-up fade-up-4">
        <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Start Free Trial →</a>
        <button class="btn btn--outline btn--lg" data-demo-trigger>See It In Action →</button>
      </div>
      <div class="fp-trust fade-up fade-up-4">
        <span>✓ 250M+ profiles</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ 30M+ companies</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ 30 leads/day per agent</span>
        <span class="fp-trust__dot">·</span>
        <span>✓ 5 min set up time</span>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2 — BEFORE / AFTER
───────────────────────────────────────────── -->
<section class="section new-shift">
  <div class="container">

    <div class="new-shift__header">
      <div class="new-shift__header-left">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          Before &amp; After
        </div>
        <h2 class="new-shift__headline">Hours of research every day.<br /><span class="new-shift__accent">Or none at all.</span></h2>
      </div>
      <div class="new-shift__header-right">
        <p class="new-shift__lead">This is how most recruiters find clients. And this is how Flynt changes it.</p>
      </div>
    </div>

    <div class="new-shift__compare">

      <div class="new-shift__card new-shift__card--old">
        <div class="ns-badge ns-badge--old">
          <span class="ns-badge-icon ns-badge-icon--x">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </span>
          The Old Way
        </div>
        <h3 class="ns-card-title">"The pipeline stalls every time you do."</h3>
        <hr class="ns-divider" />
        <ul class="ns-list ns-list--old">
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Open 8 tabs. Start researching. Realize the data is already stale.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Rebuild your contact list from scratch over and over again.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Spend another 30 minutes finding a personalization angle — their career history, recent news, the job posting.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Two hours in. You haven't made a single call.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Land a placement. Stop prospecting. Pipeline goes quiet.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--x"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
            Monday morning. Start over.
          </li>
        </ul>
      </div>

      <div class="new-shift__shift-col" aria-hidden="true">
        <div class="new-shift__shift-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <span class="new-shift__shift-label">The Shift</span>
      </div>

      <div class="new-shift__card new-shift__card--new">
        <div class="ns-badge ns-badge--new">
          <span class="ns-badge-icon ns-badge-icon--check">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          The Flynt Way
        </div>
        <h3 class="ns-card-title">"From signal to ready-to-send before you open your laptop."</h3>
        <hr class="ns-divider" />
        <ul class="ns-list ns-list--new">
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            30 scored, matched leads waiting before you open your laptop.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Fresh contacts every morning with relevant name, title, email, phone, fit score.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Ready to use AI-written personalization hooks per lead: company, career, job, and latest news.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Open your leads. Start your calls. Zero research required.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Land a placement. Pipeline keeps filling automatically.
          </li>
          <li>
            <span class="ns-item-icon ns-item-icon--check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            Monday morning. 30 new leads with everything you need to take action already in your inbox.
          </li>
        </ul>
      </div>

    </div>

    <div class="new-shift__close">
      <div class="new-shift__close-divider">
        <span class="new-shift__close-line"></span>
        <div class="new-shift__close-icon">
          <img src="/images/logo-mark.svg" alt="" width="28" height="28" />
        </div>
        <span class="new-shift__close-line new-shift__close-line--right"></span>
      </div>
      <p>This is what BD looks like without Flynt. And with it.</p>
      <strong class="new-shift__close-headline">The difference between struggling to find clients and having them flow consistently isn't effort, it's whether you have an <span class="new-shift__accent">engine running behind you.</span></strong>
    </div>
    <div class="new-shift__spacer"></div>

  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 3 — CONFIGURATION (dark)
───────────────────────────────────────────── -->
<section class="positioning fp-config">
  <div class="container">
    <div class="fp-config__header">
      <div class="tag fp-dark-tag">One Setup</div>
      <h2 class="fp-dark-h2">One setup. Runs forever.</h2>
      <p class="fp-dark-sub">Under 5 minutes, tell Flynt exactly who you're targeting. Thousands of leads over time.</p>
    </div>
    <div class="fp-steps">
      <div class="fp-step">
        <div class="fp-step__num">01</div>
        <h3 class="fp-step__title">Define Your Market</h3>
        <p class="fp-step__body">Choose your target industries, company size range, job titles, decision-maker roles, and geography. Flynt builds its research logic around your exact criteria not surface-level keyword filters. As your business evolves, update your targets at any time and Flynt adjusts immediately.</p>
      </div>
      <div class="fp-step">
        <div class="fp-step__num">02</div>
        <h3 class="fp-step__title">Your Agent Activates</h3>
        <p class="fp-step__body">From that moment, your AI agent runs continuously in the background scanning for companies actively hiring in your target market, identifying the right decision-makers, and building a complete intelligence package on each one. No logging back in. No manual runs. It just works.</p>
      </div>
      <div class="fp-step">
        <div class="fp-step__num">03</div>
        <h3 class="fp-step__title">Leads Land Everyday</h3>
        <p class="fp-step__body">Before you open your laptop, a fresh list of scored, matched, and personalized leads is already waiting in your inbox. Every single day. Automatically. All you do is show up.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 4 — INTELLIGENCE PACKAGE
───────────────────────────────────────────── -->
<section class="section fp-intel">
  <div class="container">
    <div class="section-header section-header--center">
      <div class="tag" style="margin: 0 auto 16px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        The Intelligence Package
      </div>
      <h2>Every lead arrives ready to action.</h2>
      <p>Flynt delivers leads including everything you need to reach out with confidence. No additional research required.</p>
    </div>
    <div class="fp-cards">
      <div class="fp-card">
        <h3 class="fp-card__title">Match Score</h3>
        <p class="fp-card__desc">A percentage match against your exact criteria with a written breakdown of why this lead qualifies. You know before you click whether it's worth your time.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Decision-Maker Contact</h3>
        <p class="fp-card__desc">Name, job title, seniority level, direct email, LinkedIn profile, and timezone. Everything you need to start the conversation without tab-hopping required.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Company Context</h3>
        <p class="fp-card__desc">Industry, size, background, and what role they're actively hiring for plus a direct link to the live job posting that triggered the match.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Fit Score Breakdown</h3>
        <p class="fp-card__desc">See exactly which criteria were met: role match, hiring manager location, seniority, company size, and funding status. Transparent, specific, no ambiguity.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Recent Company Signals</h3>
        <p class="fp-card__desc">News, funding rounds, partnerships, leadership changes, and product launches surfaced as ready-to-use personalization context for more relevant outreach.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">AI Personalization Hooks</h3>
        <p class="fp-card__desc">AI-written angles per lead created from the company, the person, recent news, and the specific job posting. Drop straight into your message or outreach sequence.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 5 — MATCH SCORING
───────────────────────────────────────────── -->
<section class="section fp-scoring" style="background: var(--slate-50);">
  <div class="container">
    <div class="section-header">
      <div class="tag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Match Scoring
      </div>
      <h2>Stop guessing who's worth your time. The score tells you.</h2>
      <p>Every lead arrives with a percentage match and a written breakdown of exactly why it qualifies or where it falls short. In seconds, you know which leads to prioritize and which to skip.</p>
    </div>
    <div class="fp-score">
      <div class="fp-score__left">
        <ul class="fp-score__list">
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Role match</strong> — Does the active job posting match your target title?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Hiring manager location</strong> — Is the decision-maker in your target geography?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Hiring manager seniority</strong> — Do they have the authority to hire a recruiter?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Company size</strong> — Does headcount fall within your defined range?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Recently funded</strong> — Has the company raised funding signalling an active budget?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Company industry</strong> — Does the sector align with your target market?</span>
          </li>
        </ul>
      </div>
      <div class="fp-score__right">
        <div class="fp-callout">
          <div class="fp-callout__score">99% Match</div>
          <p class="fp-callout__name">Athena Yasaman, Director of Business Operations at Suno.</p>
          <p class="fp-callout__reason">Senior Graphic Designer role fully matches target title. New York location aligns. Series D funding confirms active hiring budget. All criteria satisfied.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 6 — AI PERSONALIZATION HOOKS
───────────────────────────────────────────── -->
<section class="section fp-hooks-section">
  <div class="container">
    <div class="section-header section-header--center">
      <h2>Unique Personalized hooks per lead. Stand out in every inbox.</h2>
      <p>Generic outreach gets ignored. Flynt writes ready-to-use personalization angles for every lead pulled from real signals about the company, the person, and the specific job. Every message stands out instead of blending in.</p>
    </div>
    <div class="fp-hooks">
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Company Hook</h3>
        <p class="fp-hook-card__desc">Based on recent news, scale, and business context. What's happening at this company right now that makes your timing relevant.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Lead Hook</h3>
        <p class="fp-hook-card__desc">Based on the decision-maker's career trajectory and role history. What their background signals about how they hire and what they value.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Job Hook</h3>
        <p class="fp-hook-card__desc">Based on the exact job posting. What the role requirements reveal about company priorities and what it signals for your conversation.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">News Hook</h3>
        <p class="fp-hook-card__desc">Based on the most recent signal Flynt detected. The most timely, specific angle available for outreach today.</p>
      </div>
      <div class="fp-hook-card fp-hook-card--wide">
        <h3 class="fp-hook-card__title">Campaign Connection</h3>
        <p class="fp-hook-card__desc">Connect your agent to a campaign sequence and Flynt tailors each hook to fit exactly where it appears in your email flow so every touchpoint feels specific, not automated.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 7 — AGENT CAPABILITIES (dark)
───────────────────────────────────────────── -->
<section class="positioning fp-agent-section">
  <div class="container">
    <div class="fp-config__header">
      <div class="tag fp-dark-tag">Inside the Intelligence Agent</div>
      <h2 class="fp-dark-h2">This is what's running in the background while you're closing.</h2>
      <p class="fp-dark-sub">Set it up once. From that point, AI Agents run continuously, automatically, and intelligently surfacing the right leads, scoring every fit, and writing your outreach angles before you open your laptop.</p>
    </div>
    <div class="fp-agent-cards">
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">Continuous Market Scanning</h3>
        <p class="fp-agent-card__tagline">250M+ profiles. 30M+ companies. No days off.</p>
        <p class="fp-agent-card__body">Your agent does not operate in batches or wait for you to log in and search. It continuously monitors your target market detecting new hiring activity, tracking decision-makers, and surfacing leads the moment the signal appears. Your pipeline moves even when you are not.</p>
      </div>
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">Signal-Based Triggering</h3>
        <p class="fp-agent-card__tagline">Reach out when it matters. Not after.</p>
        <p class="fp-agent-card__body">Leads are triggered by real hiring activity not pulled from a static list. When a company in your target market posts a role matching your criteria, your agent flags it, researches it, and delivers it. The timing advantage is built in.</p>
      </div>
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">Transparent Match Scoring</h3>
        <p class="fp-agent-card__tagline">A score with nothing hidden.</p>
        <p class="fp-agent-card__body">6 criteria. A percentage. A written explanation for every point. You see exactly why a lead scored 99% and exactly where a 74% fell short. Prioritization becomes obvious, not instinctive. No guessing, no wasted calls on weak fits.</p>
      </div>
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">Ready-to-Use Personalization</h3>
        <p class="fp-agent-card__tagline">Unique angles per lead. Written. Already there.</p>
        <p class="fp-agent-card__body">Flynt writes unique personalized outreach hooks for every lead delivered drawn from company news, the decision-maker's career trajectory, the active job posting, and the most recent signal. The personalization angle that would have taken 20 minutes to find is already waiting.</p>
      </div>
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">Multiply Your Reach</h3>
        <p class="fp-agent-card__tagline">Different markets. Same output. No extra effort.</p>
        <p class="fp-agent-card__body">Each agent covers one market. Deploy multiple agents to expand reach across industries, cities, or job titles — all running simultaneously, each delivering their own up to 30 scored leads per day. Your output grows without your workload.</p>
      </div>
      <div class="fp-agent-card">
        <h3 class="fp-agent-card__title">End-to-End From Signal to Send</h3>
        <p class="fp-agent-card__tagline">One system from detection to delivery.</p>
        <p class="fp-agent-card__body">The agent finds the lead, scores it, researches it, and writes the outreach hooks. Connect it to a campaign and those leads flow directly into your sequence with personalization already fitted to each touchpoint. Intelligence at the front. Action at the other end.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 8 — FINAL CTA
───────────────────────────────────────────── -->
<section class="final-cta">
  <div class="container">
    <div class="final-cta__inner">
      <h2>Your next client is already out there.</h2>
      <p>Flynt is already scanning. Set up your agent in 5 minutes and wake up to qualified leads tomorrow morning.</p>
      <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Start Free Trial →</a>
      <span class="final-cta__disclaimer">Cancel anytime.</span>
    </div>
  </div>
</section>

</Layout>

<style>
/* ────────────────────────────────────────────
   DARK SECTIONS (.positioning)
──────────────────────────────────────────── */
.positioning {
  position: relative;
  background: linear-gradient(to top right, #1e0a3c 0%, #3b1580 50%, #5b21b6 100%);
  padding: 80px 24px;
}

.positioning .container {
  display: flex;
  flex-direction: column;
  gap: 56px;
  position: relative;
  z-index: 2;
}

/* ────────────────────────────────────────────
   FINAL CTA
──────────────────────────────────────────── */
.final-cta {
  position: relative;
  background: var(--slate-50);
  padding: 96px 24px;
}

.final-cta__inner {
  max-width: var(--max-width);
  margin: 0 auto;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.final-cta__inner h2 {
  color: var(--black);
  font-size: clamp(2rem, 4vw, 3.2rem);
}

.final-cta__inner p {
  color: var(--slate-600);
  font-size: 1.125rem;
  max-width: 480px;
  line-height: 1.625;
}

.final-cta__disclaimer {
  font-size: 0.875rem;
  color: var(--slate-500);
}

/* ────────────────────────────────────────────
   HERO
──────────────────────────────────────────── */
.fp-hero {
  padding: 100px 0 80px;
  overflow: hidden;
  background:
    radial-gradient(ellipse 40% 100% at 100% 0%, rgba(140, 85, 235, 0.5) 0%, transparent 100%),
    #ffffff;
}

.fp-hero__inner {
  max-width: 760px;
}

.fp-hero__headline {
