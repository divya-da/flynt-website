---
import Layout from '../../layouts/Layout.astro';
import FlyntSystem from '../../components/features/FlyntSystem.astro';
import SearchWays from '../../components/features/SearchWays.astro';
import WhoFaq from '../../components/features/WhoFaq.astro';
import CreditsBlock from '../../components/features/CreditsBlock.astro';

const personas = [
  { title: 'Solo recruiters', body: "Find this week's clients in an hour, without a research team." },
  { title: 'Agency owners', body: 'Try a new market or niche before you commit a recruiter to it.' },
  { title: 'Recruiters working a live role', body: 'See who else is hiring for the same role, and pitch your shortlist to their hiring managers the same day.' },
];

const faqs = [
  { title: 'Where do the jobs come from?', body: 'Live job postings in your market from the last 24 hours, not a database snapshot.' },
  { title: "What if the results don't match what I'm looking for?", body: 'Untick the ones that miss, change a filter and search again. Every search is saved, so you can come back and fine-tune it any time.' },
  { title: 'Will I contact the same company twice?', body: "No. Companies you've already contacted are skipped on every search." },
  { title: 'Does it work with LinkedIn?', body: 'Yes. LinkedIn messaging is included on every plan, and your leads can be reached on email and LinkedIn in one sequence.' },
  { title: 'Can it run automatically?', body: "Yes. Once a search is returning companies you'd call, run it daily with an agent. The Agents page explains how." },
  { title: 'Which plans include hiring search?', body: 'Every plan, including Lite.' },
];
---

<Layout
  title="Hiring Search — Find Companies Hiring in Your Market | Flynt AI"
  description="Search live job postings in your market, choose the companies worth pursuing, find their hiring managers and send personalised outreach on email and LinkedIn. You decide at every step."
>

<!-- ─────────────────────────────────────────────
  SECTION 1 — HERO
───────────────────────────────────────────── -->
<section class="fp-hero">
  <div class="container">
    <div class="fp-hero__layout">
      <div class="fp-hero__copy fade-up fade-up-1">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          Hiring Search
        </div>
        <h1 class="fp-hero__headline">
          Find the companies<br />hiring in your market,<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">step by step.</span>
        </h1>
        <p class="fp-hero__sub">
          Search live job postings in your market, choose the companies worth pursuing, find their hiring managers, get their contact details and send personalised outreach on email and LinkedIn. Flynt does the research. You decide at every step.
        </p>
        <div class="fp-hero__ctas">
          <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--black);border-color:var(--black);">Search Your Market Free →</a>
          <button class="btn btn--outline btn--lg" data-demo-trigger>See How It Works →</button>
        </div>
        <div class="fp-trust">
          <span>✓ 250M+ profiles</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ 30M+ companies</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ Postings from the last 24 hours</span>
          <span class="fp-trust__dot">·</span>
          <span>✓ Results in minutes</span>
        </div>
      </div>

      <div class="fp-hero__visual">

        <!-- Profile card 1 — based on job posting activity -->
        <div class="hs-profile">
          <div class="hs-profile__top">
            <span class="hs-pill hs-pill--hiring">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              Actively hiring · 8 open roles
            </span>
            <span class="hs-pill hs-pill--fit">Strong fit</span>
          </div>
          <div>
            <div class="hs-profile__company">Vantara Systems</div>
            <div class="hs-profile__meta">SaaS · Austin, TX · Series B</div>
          </div>
          <div class="hs-profile__dm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            <span class="hs-profile__name">Sarah Chen</span>
            <span class="hs-profile__title">· VP of Product</span>
            <span class="hs-contact-icons">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
          </div>
          <div class="hs-profile__quote">"Saw Vantara is scaling fast — 8 open roles posted this week. We place senior engineers in SaaS at exactly this stage. Worth a quick chat?"</div>
        </div>

        <!-- Profile card 2 — based on recent promotion -->
        <div class="hs-profile">
          <div class="hs-profile__top">
            <span class="hs-pill hs-pill--promo">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              Recently promoted
            </span>
            <span class="hs-pill hs-pill--fit">Strong fit</span>
          </div>
          <div>
            <div class="hs-profile__company">Meridian Capital</div>
            <div class="hs-profile__meta">Financial services · New York, NY</div>
          </div>
          <div class="hs-profile__dm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            <span class="hs-profile__name">James Okafor</span>
            <span class="hs-profile__title">· VP of Engineering</span>
            <span class="hs-contact-icons">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
          </div>
          <div class="hs-profile__quote">"Congrats on the VP move, James. New leadership roles usually mean a hiring push — if you're building the team, we know fintech eng in New York well."</div>
        </div>

        <div class="fp-hero__note">Sample profiles for illustration. Companies and people shown are fictional.</div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 2 — THE PROBLEM
───────────────────────────────────────────── -->
<section class="section fs-problem">
  <div class="container">
    <div class="fs-problem__split">
      <div class="fs-problem__head">
        <div class="tag">The Problem</div>
        <h2 class="fs-problem__h2">Finding clients by hand takes <span class="fs-hl">the whole morning.</span></h2>
      </div>
      <div class="fs-problem__body">
        <p>Open eight tabs. Scroll the job boards. Work out who owns the hire, hunt down their email, then read the posting for something worth saying. Thirty minutes to find one personalisation angle, two hours before you make a single call, and by Monday the list is stale and you start over.</p>
        <p>Hiring search does the same research in minutes, and stops after each step so you choose what happens next. <strong>Your judgement, without the busywork.</strong></p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 3 — HOW IT WORKS: STEP BY STEP
───────────────────────────────────────────── -->
<section class="section fs-steps-section" id="how">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom: 40px;">
      <div class="tag" style="margin: 0 auto 16px;">Step by Step</div>
      <h2>Five steps from a job posting<br />to a sent message.</h2>
      <p style="max-width: 720px;">You see the companies before you pick them, the hiring managers before you target them, and the message before it sends.</p>
    </div>
    <div class="fs-steps-grid">
      <div class="fs-step-card">
        <div class="fs-step-num">Step 1</div>
        <h3 class="fs-step-title">Search jobs and choose the companies</h3>
        <p class="fs-step-desc">Set the job titles, locations, industries and company size you recruit for. Flynt searches postings from the last 24 hours and lists the companies behind them.</p>
      </div>
      <div class="fs-step-card">
        <div class="fs-step-num">Step 2</div>
        <h3 class="fs-step-title">Find the hiring managers</h3>
        <p class="fs-step-desc">Flynt finds the people most likely to own the hire at each company you chose, scored against your criteria with the reasoning written out.</p>
      </div>
      <div class="fs-step-card">
        <div class="fs-step-num">Step 3</div>
        <h3 class="fs-step-title">Get contact details and context</h3>
        <p class="fs-step-desc">Verified email, LinkedIn and recent company news, pulled only for the people you selected. Phone numbers too, with the phone add-on.</p>
      </div>
      <div class="fs-step-card">
        <div class="fs-step-num">Step 4</div>
        <h3 class="fs-step-title">Personalise and review</h3>
        <p class="fs-step-desc">AI writes a personalised angle for every lead from their own job posting and recent company news, shown to you before anything leaves.</p>
      </div>
      <div class="fs-step-card fs-step-card--active">
        <div class="fs-step-num">Step 5</div>
        <h3 class="fs-step-title">Add to a campaign</h3>
        <p class="fs-step-desc">Add the leads you kept to a sequence on email and LinkedIn in one click. Not ready? Skip it and come back. The search keeps your place.</p>
      </div>
    </div>
    <div class="fs-steps-close">
      <p><strong>Nothing is chosen for you and nothing is hidden.</strong> If a search isn't returning the leads you want, you can see exactly which step to change.</p>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 4 — EVERY LEAD
───────────────────────────────────────────── -->
<section class="section fp-intel">
  <div class="container">
    <div class="section-header section-header--center">
      <div class="tag" style="margin: 0 auto 16px;">Every Lead</div>
      <h2>Not a contact list.<br /><span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">A shortlist with reasons attached.</span></h2>
    </div>
    <div class="fp-cards">
      <div class="fp-card">
        <h3 class="fp-card__title">Companies hiring right now</h3>
        <p class="fp-card__desc">From postings that went live in the last 24 hours, with a direct link to the posting that triggered the match.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">The decision maker</h3>
        <p class="fp-card__desc">The person most likely to own the hire, scored for how well they match your criteria.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Contact details</h3>
        <p class="fp-card__desc">Verified email, phone number* and LinkedIn profile.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Why it scored</h3>
        <p class="fp-card__desc">A written breakdown against role, location, seniority, company size, funding and industry.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">Recent company news</h3>
        <p class="fp-card__desc">Funding, acquisitions and leadership changes, surfaced as context you can open with.</p>
      </div>
      <div class="fp-card">
        <h3 class="fp-card__title">The outreach, already written</h3>
        <p class="fp-card__desc">AI personalization built from their own job posting, which you read and edit before anything sends.</p>
      </div>
    </div>
    <p class="fs-footnote">* Phone numbers need the phone add-on.</p>
    <div class="fs-contacted-banner">
      <div>
        <h3>Companies you've already contacted are skipped.</h3>
        <p>Automatically, on every search. You never approach the same company twice, and you never have to remember who you emailed last month.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 5 — MATCH SCORING
───────────────────────────────────────────── -->
<section class="section fp-scoring" style="background: var(--slate-50);">
  <div class="container">
    <div class="fp-scoring__header">
      <div class="fp-scoring__header-left">
        <div class="tag">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Match Scoring
        </div>
        <h2>Stop guessing who's worth your time. <span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">The score</span> tells you.</h2>
      </div>
      <div class="fp-scoring__header-right">
        <p>Every lead arrives with a percentage match and a written breakdown of exactly why it qualifies or where it falls short. In seconds, you know which leads to prioritize and which to skip.</p>
      </div>
    </div>
    <div class="fp-score">
      <div class="fp-score__left">
        <ul class="fp-score__list">
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Role match</strong> — Does the active job posting match your target title?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Hiring manager location</strong> — Is the decision-maker in your target geography?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Hiring manager seniority</strong> — Do they have the authority to hire a recruiter?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Company size</strong> — Does headcount fall within your defined range?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Recently funded</strong> — Has the company raised funding signalling an active budget?</span>
          </li>
          <li>
            <span class="fp-score__check"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Company industry</strong> — Does the sector align with your target market?</span>
          </li>
        </ul>
      </div>
      <div class="fp-score__right">
        <div class="fp-callout">
          <div class="fp-callout__score">99% Match</div>
          <p class="fp-callout__name">Athena Yasaman, Director of Business Operations at Suno.</p>
          <p class="fp-callout__reason">Senior Graphic Designer role fully matches target title. New York location aligns. Series D funding confirms active hiring budget. All criteria satisfied.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 6 — AI PERSONALIZATION HOOKS
───────────────────────────────────────────── -->
<section class="section fp-hooks-section">
  <div class="container">
    <div class="section-header section-header--center">
      <h2>A <span style="color: var(--purple); -webkit-text-stroke: 0.6px var(--purple);">unique hook</span> for every lead. Stand out in every inbox.</h2>
      <p style="max-width: none;">Generic outreach gets ignored. Flynt writes a personalised angle for every lead – pulled from real signals about the company, the person, and the job.</p>
    </div>
    <div class="fp-hooks">
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Company Hook</h3>
        <p class="fp-hook-card__desc">What's happening at this company right now that makes your timing relevant.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Lead Hook</h3>
        <p class="fp-hook-card__desc">What the decision-maker's background signals about how they hire and what they value.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">Job Hook</h3>
        <p class="fp-hook-card__desc">What the specific job posting reveals about company priorities.</p>
      </div>
      <div class="fp-hook-card">
        <h3 class="fp-hook-card__title">News Hook</h3>
        <p class="fp-hook-card__desc">The most timely, specific angle available – based on the latest signal Flynt detected.</p>
      </div>
      <div class="fp-hook-card fp-hook-card--wide">
        <h3 class="fp-hook-card__title">Campaign Connection</h3>
        <p class="fp-hook-card__desc">Add your leads to a campaign and Flynt tailors each hook to fit exactly where it appears in your sequence — so every touchpoint feels personal, not automated.</p>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 7 — THREE WAYS IN (shared) -->
<SearchWays current="hiring" />

<!-- SECTION 8 — BUILT INTO THE WHOLE SYSTEM (shared) -->
<FlyntSystem intro="A hiring search is not a standalone list. Every lead you keep flows straight into the tools you already use in Flynt." />

<!-- SECTION 9 — WHO IT IS FOR + FAQ -->
<WhoFaq heading="Built for recruiters who want to" accent="see the market first." personas={personas} faqs={faqs} />

<!-- SECTION 10 — CREDITS -->
<CreditsBlock
  title="Search as much as you like.<br />You pay for what you use."
  body="No daily search limit and no per-search fee. Every plan comes with a monthly credit balance, every step shows its cost before you spend it, and you can top up any time. On Lite's 2,500 credits that's around 528 fully worked leads a month: found, enriched, written and sent on email and LinkedIn."
/>


<!-- ─────────────────────────────────────────────
  SECTION 12 — FINAL CTA
───────────────────────────────────────────── -->
<section class="final-cta">
  <div class="container">
    <div class="final-cta__inner">
      <h2>Your market is hiring right now.<br />Go look.</h2>
      <p>One search, five minutes, no setup. See the companies, the hiring managers and the outreach before you spend a minute on research.</p>
      <a href="https://app.tryflynt.ai/" class="btn btn--primary btn--lg" style="background:var(--white);color:var(--purple-900);border-color:var(--white);">Search Your Market Free →</a>
      <span class="final-cta__disclaimer">7 days free with 500 credits. Cancel anytime.</span>
    </div>
  </div>
</section>

</Layout>

<style>
/* ────────────────────────────────────────────
   SHARED — reused from feature page pattern
──────────────────────────────────────────── */
.positioning {
  position: relative;
  background: linear-gradient(to top right, #1e0a3c 0%, #3b1580 50%, #5b21b6 100%);
  padding: 80px 24px;
}

.positioning .container {
  display: flex;
  flex-direction: column;
  gap: 56px;
  position: relative;
  z-index: 2;
}

.fp-dark-tag {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.9);
  margin-bottom: 20px;
}

.fp-dark-h2 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin: 0 0 16px;
  -webkit-text-stroke: 0.6px #fff;
  max-width: 680px;
}

.fp-dark-sub {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  max-width: 580px;
  margin: 0;
  font-weight: 400;
}

.fp-config__header {
  margin-bottom: 48px;
}

.fp-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.fp-step {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  padding: 28px 32px;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.fp-step:hover {
  background: rgba(255,255,255,0.09);
  border-color: rgba(255,255,255,0.2);
  transform: translateY(-4px);
}

.fp-step__num {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 800;
  color: var(--purple-300);
  line-height: 1;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.fp-step__title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 10px;
  -webkit-text-stroke: 0;
  line-height: 1.3;
}

.fp-step__body {
  font-size: 1rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin: 0;
  font-weight: 400;
