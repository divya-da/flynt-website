            </div>
            <div class="fp-stage__card-menu">⋮</div>
          </div>
          <div class="fp-stage__card-company">TechCorp · 94% match</div>
          <div class="fp-stage__card-deal">
            <span class="fp-stage__card-deal-label">DEAL VALUE</span>
            <span class="fp-stage__card-deal-value">$8,000</span>
          </div>
        </div>
        <div class="fp-stage__card" style="margin-top:8px;">
          <div class="fp-stage__card-top">
            <div class="fp-stage__avatar" style="background:#0ea5e9;">JL</div>
            <div class="fp-stage__card-info">
              <div class="fp-stage__card-name">James Liu</div>
              <div class="fp-stage__card-title">VP Engineering</div>
            </div>
