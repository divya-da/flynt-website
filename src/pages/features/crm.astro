<!-- ─────────────────────────────────────────────
  SECTION 5 — LEAD RECORD
───────────────────────────────────────────── -->
<section class="section" style="background: var(--white);">
  <div class="container">
    <div class="tag" style="margin-bottom: 24px;">Lead Record</div>
    <div class="fp-record-layout">

      <div>
        <h2 style="margin-bottom: 20px;">Not just a contact. <span class="hl">A complete record.</span></h2>
        <p>Most CRMs store a name and an email. Flynt Pipeline stores a scored, researched, personalized lead with the full intelligence package from the moment it arrived. Match score, contact details, company signals, personalization hooks, stage history, and notes. Open it and there's nothing left to look up.</p>
      </div>

      <ul class="fp-record-features">
        <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </span>
          Match score &amp; full breakdown on arrival
        </li>
        <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          Complete contact details — email, LinkedIn, timezone
        </li>
        <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          Company signals and recent news
        </li>
        <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          </span>
          AI personalization hooks ready to use
        </li>
        <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </span>
          Stage history and activity log
        </li>
       <!--  <li>
          <span class="fp-feat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </span>
          Notes field for your own context
        </li>-->
      </ul>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  SECTION 6A — STATS BAR
───────────────────────────────────────────── -->
<div class="fp-stats">
  <div class="container">
    <div class="fp-stats__header">
      <h2 class="fp-stats__headline">Leads in. <span class="hl">Nothing lost.</span></h2>
    </div>
    <div class="fp-stats-grid">
      <div>
        <div class="fp-stat__number">Up to 30 leads/day</div>
        <div class="fp-stat__label">per agent into your pipeline</div>
      </div>
      <div>
        <div class="fp-stat__number">Instant search</div>
        <div class="fp-stat__label">across full lead history</div>
