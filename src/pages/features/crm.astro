          <span class="fp-stage__dot"></span>
          <span class="fp-stage__name">Interested</span>
          <span class="fp-stage__count">2</span>
        </div>
        <div class="fp-stage__value">$13,000</div>
        <div class="fp-stage__add">+ Add</div>
